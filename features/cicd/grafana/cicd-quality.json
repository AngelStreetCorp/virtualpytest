          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Job pass rate per day by layer",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cicd-postgres"
      },
      "gridPos": {
        "x": 12,
