    {
      "id": 7,
      "type": "timeseries",
      "title": "Runs passed / failed per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cicd-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cicd-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(started_at,'1d') AS time,\n  count(*) FILTER (WHERE overall='passed') AS \"Passed\",\n  count(*) FILTER (WHERE overall<>'passed') AS \"Failed / partial\"\nFROM ci_run_summary WHERE $__timeFilter(started_at) AND project IN ($project) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Passed"
            },
            "properties": [
              {
                "id": "color",
