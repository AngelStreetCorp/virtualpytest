          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(j.finished_at,'1d') AS time, j.layer AS metric,\n  round(100.0*count(*) FILTER (WHERE j.status='success')/NULLIF(count(*),0),1) AS value\nFROM ci_jobs j WHERE $__timeFilter(j.finished_at) AND j.project IN ($project) AND j.layer IN ($layer) GROUP BY 1,2 ORDER BY 1",
          "refId": "A"
        }
