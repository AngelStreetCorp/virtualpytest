    {
      "id": 9,
      "type": "table",
      "title": "Jobs \u2014 last result, pass % and runs in range (per project)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cicd-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 10
      },
      "description": "One row per project/job. Last result is all-time; Runs / Pass % are limited to the time range.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cicd-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH last AS (\n  SELECT DISTINCT ON (project, job) project, job, category, layer, status, finished_at, report_url\n  FROM ci_jobs j WHERE j.project IN ($project) AND j.layer IN ($layer) ORDER BY project, job, finished_at DESC),\nwin AS (SELECT project, job, status FROM ci_jobs j WHERE $__timeFilter(j.finished_at) AND j.project IN ($project) AND j.layer IN ($layer))\nSELECT l.project AS \"Project\", l.job AS \"Job\", l.layer AS \"Layer\", l.category AS \"Category\",\n  l.finished_at AS \"Last run\", CASE WHEN l.status='success' THEN 'PASS' WHEN l.status='failure' THEN 'FAIL' ELSE upper(l.status) END AS \"Last result\",\n  count(w.job) AS \"Runs (range)\",\n  round(100.0*count(w.job) FILTER (WHERE w.status='success')/NULLIF(count(w.job),0),1) AS \"Pass % (range)\",\n  CASE WHEN l.report_url IS NOT NULL THEN '<a href=\"' || l.report_url || '\" target=\"_blank\">report</a>' END AS \"Last report\"\nFROM last l LEFT JOIN win w USING (project, job)\nGROUP BY l.project, l.job, l.layer, l.category, l.finished_at, l.status, l.report_url\nORDER BY l.project, l.layer, l.job",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last run"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last result"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "PASS": {
                        "color": "green",
                        "index": 0,
                        "text": "\u2705 PASS"
                      },
                      "FAIL": {
                        "color": "red",
                        "index": 1,
                        "text": "\u274c FAIL"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pass % (range)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 80
                    },
                    {
                      "color": "green",
                      "value": 100
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last report"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "markdown"
                }
              },
              {
                "id": "custom.align",
                "value": "center"
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": []
      }
    },
