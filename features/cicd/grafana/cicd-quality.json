    {
      "id": 11,
      "type": "table",
      "title": "Runs (range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cicd-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cicd-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS \"Started\", project AS \"Project\", run AS \"Run\", branch AS \"Branch\", left(sha,7) AS \"Commit\", runner AS \"Runner\",\n  upper(overall) AS \"Result\", jobs_passed || ' / ' || jobs AS \"Jobs passed\",\n  CASE WHEN report_url IS NOT NULL THEN '<a href=\"' || report_url || '\" target=\"_blank\">open</a>' END AS \"Report\"\nFROM ci_run_summary WHERE $__timeFilter(started_at) AND project IN ($project) ORDER BY started_at DESC LIMIT 500",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
