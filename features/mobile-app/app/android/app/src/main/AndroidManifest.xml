<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!-- Pinned to portrait, for the same reason CaptureActivity below is: this is a
             phone-held-in-portrait app and every screen is laid out for it. Unlocked, the
             activity takes whatever rotation the device happens to be in when it is
             (re)launched — which on a cloud device farm is not a person's hand. A
             BrowserStack Galaxy S23 came back landscape on activate_app while a Sauce
             Galaxy S23 FE stayed portrait, so the same test produced portrait evidence on
             one vendor and sideways evidence on the other, and setting the orientation
             back over the wire did not restore the screenshot. configChanges already lists
             orientation, so this costs no activity recreation. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- zxing-android-embedded's own manifest hard-codes CaptureActivity to
             android:screenOrientation="sensorLandscape" (its library AndroidManifest.xml —
             IntentIntegrator#setOrientationLocked(false) in PhoneAgentPlugin#scanQr only lets it
             rotate between the two landscape variants, it can't reach portrait). Every other
             screen in this phone-held-in-portrait app is unlocked, so scanning a QR forced a
             sideways flip; override it back to portrait like the rest of the app.
             tools:replace is required, not tools:merge: two manifests disagreeing on the same
             attribute for the same component is a hard build-time conflict otherwise. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Screen streaming (§1.3 `frame`): foreground service so MediaProjection survives
             backgrounding. It goes foreground as dataSync immediately (API 34+ kills a service
             that does not call startForeground within seconds) and switches to the mandatory
             mediaProjection type once the user has granted capture. -->
        <service
            android:name=".PhoneAgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProjection" />

        <!-- Input + UI dump (§1.3 tap/swipe/key/text/dump_ui): AccessibilityService, user-enabled
             from Settings (PhoneAgentPlugin#openAccessibilitySettings). -->
        <service
            android:name=".VptAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

    <!-- Package visibility (API 30+): `list_apps`/`launch_app` (§1.3) need to see and start
         every launchable app, not just ones this app already talked to. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
