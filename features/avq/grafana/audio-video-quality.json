          "targets": [
            {
              "datasource": {
                "uid": "supabase-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT device_name AS \"Device\",\n  COALESCE(sum((events->'blackscreen'->>'count')::int),0) AS \"Blackscreen events\",\n  round(COALESCE(sum(blackscreen_seconds),0),0) AS \"Blackscreen (s)\",\n  round(COALESCE(max((events->'blackscreen'->>'longestMs')::int),0)/1000.0,0) AS \"Longest blk (s)\",\n  COALESCE(sum((events->'freeze'->>'count')::int),0) AS \"Freeze events\",\n  round(COALESCE(sum(freeze_seconds),0),0) AS \"Freeze (s)\",\n  round(COALESCE(max((events->'freeze'->>'longestMs')::int),0)/1000.0,0) AS \"Longest frz (s)\",\n  COALESCE(sum((events->'macroblocks'->>'count')::int),0) AS \"Macroblock events\",\n  round(COALESCE(sum(macroblocks_seconds),0),0) AS \"Macroblocks (s)\"\nFROM quality_metrics WHERE $__timeFilter(timestamp) AND device_name IN (${device:sqlstring}) AND host_name IN (${host:sqlstring}) GROUP BY device_name ORDER BY device_name"
            }
          ]
        },
