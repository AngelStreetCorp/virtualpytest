        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "uid": "supabase-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  (SELECT count(DISTINCT device_id) FROM quality_metrics WHERE $__timeFilter(timestamp) AND device_name IN (${device:sqlstring}) AND host_name IN (${host:sqlstring})) AS \"Devices\",\n  (SELECT count(*) FROM (SELECT device_id FROM quality_metrics WHERE $__timeFilter(timestamp) AND device_name IN (${device:sqlstring}) AND host_name IN (${host:sqlstring}) GROUP BY device_id HAVING avg(video_availability) > 0.5) q) AS \"With Video\",\n  (SELECT count(*) FROM (SELECT device_id FROM quality_metrics WHERE $__timeFilter(timestamp) AND device_name IN (${device:sqlstring}) AND host_name IN (${host:sqlstring}) GROUP BY device_id HAVING avg(audio_availability) > 0.5) q) AS \"With Audio\",\n  (SELECT count(*) FROM quality_metrics WHERE $__timeFilter(timestamp) AND device_name IN (${device:sqlstring}) AND host_name IN (${host:sqlstring})) AS \"Minutes\",\n  (SELECT COALESCE(sum((events->'noSound'->>'count')::int),0)+COALESCE(sum((events->'highBlurriness'->>'count')::int),0)+COALESCE(sum((events->'highBlockiness'->>'count')::int),0) FROM quality_metrics WHERE $__timeFilter(timestamp) AND device_name IN (${device:sqlstring}) AND host_name IN (${host:sqlstring})) AS \"Quality Events\",\n  (SELECT round(avg(video_mos),2) FROM quality_metrics WHERE $__timeFilter(timestamp) AND device_name IN (${device:sqlstring}) AND host_name IN (${host:sqlstring})) AS \"Avg Video MOS\",\n  (SELECT round(avg(audio_mos),2) FROM quality_metrics WHERE $__timeFilter(timestamp) AND device_name IN (${device:sqlstring}) AND host_name IN (${host:sqlstring})) AS \"Avg Audio MOS\""
        }
      ]
    },
