# VirtualPyTest frontend — build-time values (Vite bakes them into the bundle: rebuild after a change).
# Installers fill URLs from the machine address: setup/local/linux/shared/write_env.sh
VITE_SERVER_URL=http://localhost:5109
VITE_GRAFANA_URL=http://localhost:3000
# Storage public base: set = files linked directly, unset = presigned URLs via the server
VITE_CLOUDFLARE_R2_PUBLIC_URL=
VITE_DEV_MODE=false
VITE_PROJECT_NAME=VirtualPyTest
VITE_PROJECT_TAGLINE=Automated Testing Platform
VITE_PROJECT_LOGO_URL=/brand/logo.svg
VITE_PROJECT_TITLE=VirtualPyTest Web Interface
VITE_SHOW_FOOTER=true
# Login page (Supabase auth). Both empty = open mode, no login. Pair with the server's
# SUPABASE_JWT_SECRET (see .env.example at the repo root, "AUTH POSTURE").
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# No-Supabase (JWT disabled) deployments: the weak server key the SPA sends as
# X-Server-Key so the closed-by-default backend accepts it. Must equal the
# backend SERVER_PUBLIC_KEY and MUST differ from API_KEY (never bundle API_KEY).
# xVITE_SERVER_PUBLIC_KEY=your-weak-server-public-key

# Auto-sign (CI / agent-browser tests): mirrors AUTO_SIGN_* on the server; leave off otherwise.
# VITE_AUTO_SIGN_ENABLED=false
# VITE_AUTO_SIGN_TOKEN=

# Feature toggles (true/false). Unset = enabled.
VITE_FEATURE_DEPLOYMENTS=true
# Comma-separated feature names hidden from this build (docs/technical/FEATURES.md)
VITE_DISABLED_FEATURES=

# Navbar item visibility — deployment-wide overrides.
# Values are comma-separated **full route paths** (same convention as
# workspace hidden_pages). Per-workspace hides live in the DB and override
# these at runtime. Unset = nothing hidden at the env level.
# Examples:
#   VITE_NAV_HIDDEN=/integrations/jira,/integrations/slack
#   VITE_NAV_DISABLED=/langfuse-dashboard
#   VITE_NAV_COMING_SOON=/configuration/cicd-reports,/configuration/code-deployment
VITE_NAV_HIDDEN=
VITE_NAV_DISABLED=
VITE_NAV_COMING_SOON=
