[Unit]
Description=VirtualPyTest Frontend Service (Production)
Documentation=https://github.com/vercel/serve
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vpt_user
Group=vpt_user
WorkingDirectory=/opt/virtualpytest/frontend
Environment="PATH=/opt/virtualpytest/venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/home/vpt_user/.local/bin"
Environment="NODE_ENV=production"
# Frontend VM has 1.9GB RAM; the default V8 heap ceiling on that box is too
# low for `vite build`'s post-bundle gzip-size reporting on this app's ~2.5MB
# main chunk and aborts with an OOM crash. Raise it explicitly so the build
# doesn't depend on Restart=on-failure retrying into a luckier memory state.
Environment="NODE_OPTIONS=--max-old-space-size=1536"

# Reload systemd in case the service file was updated via code sync
ExecStartPre=+/usr/bin/systemctl daemon-reload

# Make dist/ current — normally a no-op that returns in about a second.
# This used to be `npm run build`, i.e. the full doc pipeline + Vite build with
# the service already stopped, so every `systemctl restart` was 4+ minutes of
# hard downtime (BUG-0103). update_core.sh now runs this same script right after
# the rsync, while the previous `serve` is still answering requests; by the time
# systemd gets here the bundle stamp matches and there is nothing to do.
# It still rebuilds when the tree changed without a deploy build — into dist.new,
# swapped in at the end — so a restart can never serve a stale bundle.
ExecStartPre=/usr/bin/env bash scripts/ensure_dist.sh

# Serve the built dist folder on port 5073
ExecStart=/usr/bin/npm run start

# Restart policy
Restart=on-failure
RestartSec=10

# Resource limits. ExecStartPre is a stamp check on the normal path, but it still
# has to cover the fallback where it finds no usable bundle and builds one: on a
# 4-vCPU machine a cold build (doc generation + Vite) takes 10-20 min, and a
# shorter timeout makes systemd kill and restart it forever.
TimeoutStartSec=1800
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vpt-frontend-prod

[Install]
WantedBy=multi-user.target
