{
  "name": "virtualpytest-web",
  "version": "1.0.0",
  "description": "Web interface for VirtualPyTest framework",
  "type": "module",
  "scripts": {
    "dev": "./node_modules/.bin/vite",
    "prebuild": "bash scripts/prebuild.sh",
    "build": "./node_modules/.bin/vite build",
    "start": "[ -d dist ] || npm run build && ./node_modules/.bin/serve -s dist -l 5073 --no-clipboard -c \"$(pwd)/serve.json\"",
    "preview": "./node_modules/.bin/vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lint": "^6.9.7",
    "@emotion/react": "11.11.1",
    "@emotion/styled": "11.11.0",
    "@mui/icons-material": "5.15.0",
    "@mui/material": "5.15.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-query": "5.80.7",
    "@types/dagre": "^0.7.53",
    "@uiw/react-codemirror": "^4.25.10",
    "dagre": "^0.8.5",
    "hls.js": "1.6.5",
    "qrcode.react": "4.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hot-toast": "2.5.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "reactflow": "11.10.1",
    "recharts": "3.10.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@types/node": "20.0.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "6.14.0",
    "@typescript-eslint/parser": "6.14.0",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "10.4.16",
    "eslint": "8.55.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.5",
    "postcss": "^8.5.19",
    "postcss-nesting": "12.0.2",
    "serve": "^14.2.5",
    "tailwindcss": "3.3.6",
    "typescript": "5.2.2",
    "vite": "^6.3.6"
  },
  "overrides": {
    "minimatch": "^10.0.0",
    "rollup": "^4.59.0",
    "serve": "^14.2.5",
    "serve-handler": "^6.1.6"
  }
}
