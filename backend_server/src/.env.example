# VirtualPyTest Backend Server Environment Configuration
# Copy this file to .env and configure your settings

# Server Configuration
SERVER_URL=http://localhost:5109
SERVER_PORT=5109
SERVER_MODE=server
SERVER_NAME=VirtualPyTest Backend Server
DEBUG=false

# Database Configuration (PostgreSQL/Supabase)
DATABASE_URL=postgresql://virtualpytest_user:virtualpytest_pass@localhost:5432/virtualpytest
SUPABASE_URL=your_supabase_url_here
# Browser-reachable URL of the SAME Supabase (SUPABASE_URL is often LAN-only).
# /server/auth/check advertises it so the frontend knows which Supabase to sign in
# to for this server, and groups sessions by it — identical on servers sharing a
# Supabase, distinct on servers that do not (TASK-18).
SUPABASE_PUBLIC_URL=https://your-domain.example/supabase
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# service_role (Auth Admin API: create/delete users). Server-side only, never frontend.
# Self-hosted: pull from the running stack's storage container (SERVICE_KEY env).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Internal base incl. sub-path, e.g. http://192.168.x.106:3000/grafana (NOT the public URL)
GRAFANA_URL=your_internal_grafana_url_here
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_server_admin_password_here

# Authentication & API Keys
API_KEY=your_api_key_here
GITHUB_TOKEN=your_github_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Local model server instead of a hosted provider (any OpenAI-compatible endpoint:
# Ollama, vLLM, llama.cpp, LM Studio...). Configurable from Settings > AI as well.
# AI_PROVIDER=local
# LOCAL_AI_BASE_URL=http://10.10.10.10:8000/v1
# LOCAL_AI_MODEL=qwen3:8b
# LOCAL_AI_API_KEY=

# Redis Configuration (choose one)
#
# Local Redis (self-hosted):
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
#
# Remote Redis (separate VM):
REDIS_URL=redis://:CHANGE_ME@192.168.x.101:6379/0
#
# Cloud Redis (Upstash):
# REDIS_URL=https://your-redis-url.upstash.io
# REDIS_TOKEN=your_upstash_redis_token_here

# Server Base URL for MCP client
SERVER_BASE_URL=http://localhost:5109
