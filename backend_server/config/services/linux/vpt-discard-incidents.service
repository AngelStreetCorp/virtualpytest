# NOTE: This is a template file for reference only.
# The actual service file is generated by setup scripts
# with correct dynamic paths for your system.

[Unit]
Description=VirtualPyTest Analyzer Discard Incident Worker
After=network.target redis-server.service
Wants=network.target

[Service]
Type=simple
User=vpt_user
Group=vpt_user
WorkingDirectory=/opt/virtualpytest/backend_server
Environment=PYTHONPATH=/opt/virtualpytest:/opt/virtualpytest/backend_server/src
Environment=PATH=/opt/virtualpytest/venv/bin:/usr/bin:/usr/local/bin
ExecStart=/opt/virtualpytest/venv/bin/python scripts/discard_worker.py
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vpt-discard-incidents

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
