# NOTE: This is a template file for reference only.
# The actual service file is generated by setup scripts
# with correct dynamic paths for your system.

[Unit]
Description=Heatmap Processor Service - 24h Circular Buffer Generation
After=network.target
Wants=network.target

[Service]
Type=simple
User=vpt_user
Group=vpt_user
WorkingDirectory=/opt/virtualpytest/backend_server
Environment=PYTHONPATH=/opt/virtualpytest/shared/lib:/opt/virtualpytest/backend_server/src
Environment=PATH=/opt/virtualpytest/venv/bin:/usr/bin:/usr/local/bin
ExecStart=/opt/virtualpytest/venv/bin/python scripts/heatmap_processor.py
Restart=always
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vpt-heatmap

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
