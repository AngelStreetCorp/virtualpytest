# NOTE: This is a template file for reference only.
# The actual service file is generated by setup scripts
# with correct dynamic paths for your system.

[Unit]
Description=VirtualPyTest Backend Server Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=vpt_user
Group=vpt_user
WorkingDirectory=/opt/virtualpytest/backend_server
Environment=PYTHONPATH=/opt/virtualpytest/shared/lib:/opt/virtualpytest/backend_server/src
Environment=PATH=/opt/virtualpytest/venv/bin:/usr/bin:/usr/local/bin
Environment=PYTHONUNBUFFERED=1
# Reload systemd in case the service file was updated via code sync
ExecStartPre=+/usr/bin/systemctl daemon-reload
ExecStart=/opt/virtualpytest/venv/bin/python src/app.py
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vpt-server

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target