.env.bak*
*.bak
.DS_Store

venv/

.env
# Every per-host / per-environment .env-shaped file: a sibling name of `.env`,
# a name ending in `.env`, a name starting with `.env.` (e.g. `.env.staging`),
# and the depth-independent variants. Templates end in `.example` and stay
# tracked. The `vpt_windows_native.env` incident is the reason this block
# is broader than a single `.env` line.
*.env
.env.*
**/*.env
**/.env.*
# Specific per-deployment names that have surfaced in past commits.
.env.host
.env.server
.env.docker
.env.proxmox
vpt_windows_native.env
*.pyc
nohup.out

