# VirtualPyTest — project-level configuration (backend_server, shared library, scripts)
# Copy to .env: cp .env.example .env    (installers do it and fill it: setup/local/linux/shared/write_env.sh)
# Every variable here is read by the code; the reference is docs/get-started/configuration.md

# =====================================================
# SERVER
# =====================================================
SERVER_NAME=vpt-server
# SERVER_URL: how THIS box reaches its own server (loopback when co-located).
# SERVER_PUBLIC_URL: the server's public name; scripts, Grafana and docs read it (no hostname literals in code).
SERVER_URL=http://localhost:5109
SERVER_PUBLIC_URL=https://CHANGE_ME.example.com
# Scripts under scripts/: VPT_SERVER_URL overrides SERVER_PUBLIC_URL; VPT_MCP_URL = https://<server>/server/mcp
# (localize tools); FLEET_HEALTH_SERVERS = comma-separated server URLs for fleet_health_report.py
# VPT_SERVER_URL=
# VPT_MCP_URL=
# FLEET_HEALTH_SERVERS=http://localhost:5109
SERVER_PORT=5109
FLASK_SECRET_KEY=CHANGE_ME
API_KEY=CHANGE_ME
# Share-one-report snapshot links (TASK-49): off unless true; the share button is hidden while off
REPORT_SHARING_ENABLED=false
# generate: python3 -c 'import secrets; print(secrets.token_hex(32))'  — API_KEY must be identical on every host
# Postman shared workspace access is server-side; users do not need individual Postman keys.
# Set the key from Postman for the shared collections. Workspace ID is public and defaults
# to VirtualPyTest's workspace; optionally override it for a different workspace.
# POSTMAN_API_KEY=
# POSTMAN_WORKSPACE_ID=4e7a465c-a542-4440-8903-48787f03942a
# Infra VMs whose VM agent (infra/vm_agent/) this server pulls once a minute for the
# System Service Status Grafana dashboard: name=host:port, comma-separated. Set it on ONE
# server per database (it also records the DB backup status). Unset = only this server's
# own services are recorded.
# INFRA_VM_AGENTS=database=192.168.x.102:9110,storage=192.168.x.101:9110
# Credentials entered in the UI (TestRail, JIRA, Slack) — outside the project, deploys wipe it
# VPT_CONFIG_DIR=~/.config/virtualpytest

# =====================================================
# /server/* AUTH POSTURE — closed by default
# =====================================================
# Exactly one of these applies, in this order of precedence:
#   SERVER_OPEN_MODE=true      no browser LOGIN required (lab / trusted network only). Wins
#                              over a configured SUPABASE_JWT_SECRET. It waives the login
#                              only: a direct, non-browser call (curl, a script, a service)
#                              still has to send X-API-Key whenever API_KEY is set above.
#                              That is a speed bump, not a boundary — set a JWT secret and
#                              turn this off on anything reachable from outside the LAN.
#   SUPABASE_JWT_SECRET set    browser users authenticate with a Supabase login (JWT);
#                              services use X-API-Key. The frontend needs VITE_SUPABASE_URL
#                              and VITE_SUPABASE_ANON_KEY for the login page.
#   SERVER_PUBLIC_KEY set      no Supabase: the SPA sends this weak key as X-Server-Key.
#                              MUST differ from API_KEY; it is published in the bundle
#                              (VITE_SERVER_PUBLIC_KEY), so it is a speed bump, not auth.
#   none of the above          every anonymous request gets 401.
SERVER_OPEN_MODE=true
# SERVER_PUBLIC_KEY=
# SERVER_PUBLIC_ROLE=admin

# =====================================================
# CORS — origins allowed to call this server from a browser (BUG-0092)
# =====================================================
# Comma-separated. Only needed if your frontend is served from a DIFFERENT origin than this
# server (e.g. a Vercel-hosted frontend calling a Render-hosted server, or one frontend
# switching between several backend servers — see docs/get-started/cloud-setup.md §4.1). A
# same-origin deployment (frontend and /server/ behind the same nginx host, the default in
# docs/get-started/proxmox.md and docker.md) needs no CORS headers at all and can leave this
# unset. There is no "*" fallback — an origin not listed here simply cannot call this API from
# a browser. See docs/get-started/production-checklist.md.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com,http://localhost:5073

# =====================================================
# AUTO-SIGN (CI / agent-browser tests) — off unless you run those
# =====================================================
AUTO_SIGN_ENABLED=false
# AUTO_SIGN_TOKEN=            # python3 -c 'import secrets; print(secrets.token_hex(32))'
# AUTO_SIGN_ROLE=admin

# =====================================================
# DATABASE — Supabase (cloud project or self-hosted; the VM installer fills these)
# =====================================================
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=CHANGE_ME
# Same Supabase, but the URL a BROWSER can reach (SUPABASE_URL is often LAN-only, e.g.
# http://192.168.x.102:54321). Advertised by /server/auth/check so the frontend knows
# which Supabase to sign in to for THIS server (TASK-17).
#
# It is also the key the frontend groups sessions by, so it must be identical on every
# server sharing one Supabase and different on servers that do not: two servers with the
# same value share one login, a third with its own value is asked for credentials once.
# Set it even when it looks redundant — a server that omits it advertises no identity, and
# the frontend falls back to sending the primary server's token there.
# SUPABASE_PUBLIC_URL=https://your-domain.example/supabase
# service_role: server-side only, never in the frontend. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_JWT_SECRET=CHANGE_ME
# direct Postgres connection — used by Grafana's datasource, backups and Atlas analytics
# (read-only sessions; ANALYTICS_DB_URI overrides it for analytics only)
SUPABASE_DB_URI=postgresql://postgres:postgres@localhost:54322/postgres
# A server with no direct Postgres route (e.g. a Pi-hosted server) forwards Atlas analytics
# queries to a server that has one, with API_KEY. Default: the origin serving SUPABASE_URL.
# ANALYTICS_FORWARD_URL=https://your-domain.example

# =====================================================
# STORAGE — one of the two. R2 wins when all three CLOUDFLARE_R2_* credentials are set.
# =====================================================
# Cloudflare R2
# CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=virtualpytest
# CLOUDFLARE_R2_PUBLIC_URL=https://pub-<bucket-id>.r2.dev   # set = public URLs, unset = presigned
# MinIO (self-hosted, installed by setup/local/linux/storage/install_storage.sh)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=CHANGE_ME                        # generated per install by shared/write_env.sh
MINIO_BUCKET=virtualpytest
MINIO_PUBLIC_URL=http://localhost:9000            # address browsers use for stored files

# =====================================================
# JEV (decision model) — on unless switched off. Read by the SERVER on every call (restart the server
# to apply); hosts reach Jev through the server, so this one switch covers hosts too. Off: Sherlock's
# LLM (or rules without AI), test-prompt auto, the companion meter and game runs keep their own path.
# =====================================================
# JEV_ENABLED=true                          # false / 0 / no / off = Jev off everywhere
# JEV_DISABLED_USAGES=                      # optional: turn off single usages, e.g. text.decision.sherlock,text.decision.companion (a key also covers its children)
# Freeze-alert triage (TASK-55): the host measures the frozen screen, the server's Nightwatch asks Jev.
# ALERT_JEV_FACTS_ENABLED=false             # HOST (.env of each host; restart vpt-monitor-img): write metadata.jev_facts on every new freeze alert (OCR is skipped for cameras)
# MONITOR_PROFILE=tv_app                    # HOST (restart vpt-monitor-img, -audio, -subtitle): what the monitors do on this host. A file name in backend_host/config/monitor/profiles/ (tv_app today). Unknown name = error in the journal, then tv_app
# MONITOR_COCO_MODEL=/opt/virtualpytest/models/yolox_nano.onnx   # HOST: detector for profiles with a `coco_detect` analyzer (counting_cars). YOLOX-nano, Apache-2.0, from the official Megvii YOLOX release; NOT in git, keep it outside the project folder
# DEVICE1_MONITOR_PROFILE=tv_app            # HOST: same, for one device; wins over MONITOR_PROFILE (read per device from the per-device step on)
# DEVICE1_TIMELINE=false                    # HOST (restart vpt-timeline): build the Timeline thumbnails for this device (capture folder N = DEVICEN). Off unless true; TIMELINE_ALL=true turns it on for every device of the host. Costs ~2 s of CPU per 10-min chunk and ~29 MB of disk per device per day
# ALERT_JEV_MODE=shadow                     # SERVER (restart vpt-discard-incidents): off | shadow. shadow = ask Jev for each freeze alert with facts and log what it would do, change nothing. Any other value = off.

# =====================================================
# AI TRAINING DATASET (TASK-27, optional) — off unless TRAINING_DATA_ENABLED is set AND a
# training bucket is configured AND the team has teams.training_data_opt_in = true.
# Separate bucket, never the default one; it must NEVER get a lifecycle (expiry) rule.
# =====================================================
# TRAINING_DATA_ENABLED=false
# Dedicated MinIO instance/bucket (all four required):
# MINIO_TRAINING_ENDPOINT=http://localhost:9000
# MINIO_TRAINING_ACCESS_KEY=
# MINIO_TRAINING_SECRET_KEY=
# MINIO_TRAINING_BUCKET=vpt-training
# Public address browsers use for training images (review page); unset = sign with the endpoint above
# MINIO_TRAINING_PRESIGN_ENDPOINT=https://vpt-training.example.com
# Or R2 (uses the CLOUDFLARE_R2_* credentials above):
# R2_TRAINING_BUCKET=vpt-training

# =====================================================
# REDIS — alert / script queues (storage/install_redis.sh); Upstash also accepted (REDIS_URL=https://… + REDIS_TOKEN)
# =====================================================
# REDIS_PASSWORD is what install_redis.sh puts in `requirepass`; REDIS_URL is what the
# app connects with. write_env.sh generates the password and builds the URL from it.
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
# REDIS_TOKEN=

# =====================================================
# GRAFANA (server-side calls; internal address, with sub-path when behind nginx)
# =====================================================
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Needed when the server mirrors users into Grafana (?grafana=true) —
# see docs/integrations/user-provisioning.md
GRAFANA_SECRET_KEY=CHANGE_ME
GRAFANA_DOMAIN=your-domain.com

# =====================================================
# AI
# =====================================================
# AI: no model or provider key in .env (TASK-30). Set providers, API keys and which model
# serves each use case in the web app: Settings -> AI (Endpoints / Profiles / Routing).
# Keys are stored server-side in ~/.config/virtualpytest/ai_secrets.json.
# Upgrading from an .env that still has AI_* / LOCAL_AI_* / VLM_* / *_API_KEY entries:
# run scripts/ai_routing_import_env.py once, then delete them.
# Public website Q&A (/server/public/ask): comma-separated origins allowed to call it
PUBLIC_ASK_ALLOWED_ORIGINS=https://virtualpytest.com,https://www.virtualpytest.com
MCP_SECRET_KEY=CHANGE_ME

# =====================================================
# ENVIRONMENT
# =====================================================
DEBUG=0
