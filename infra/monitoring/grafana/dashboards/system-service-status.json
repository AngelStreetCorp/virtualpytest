      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH vms AS (\n  SELECT DISTINCT ON (vm) vm, hostname, timestamp, cpu_percent, memory_percent, memory_total_gb,\n         disk_percent, disk_total_gb, load_average_1m, cpu_count, uptime_seconds\n  FROM vm_metrics WHERE timestamp > now() - interval '1 day' AND server_name = ANY(string_to_array('${collector:csv}', ','))\n  ORDER BY vm, timestamp DESC\n), servers AS (\n  SELECT DISTINCT ON (server_name) 'server' AS vm, server_name AS hostname, timestamp, cpu_percent, memory_percent,\n         nullif(memory_total_gb, 0) AS memory_total_gb, disk_percent, nullif(disk_total_gb, 0) AS disk_total_gb,\n         load_average_1m, NULL::int AS cpu_count, uptime_seconds\n  FROM system_metrics\n  WHERE host_name = 'server' AND server_name = ANY(string_to_array('${collector:csv}', ',')) AND timestamp > now() - interval '1 day'\n  ORDER BY server_name, timestamp DESC\n), all_vms AS (SELECT * FROM servers UNION ALL SELECT * FROM vms)\nSELECT vm AS \"VM\", hostname AS \"Hostname\", cpu_percent AS \"CPU %\", memory_percent AS \"RAM %\",\n       memory_total_gb AS \"RAM GB\", disk_percent AS \"Disk %\", disk_total_gb AS \"Disk GB\",\n       load_average_1m AS \"Load 1m\", cpu_count AS \"vCPU\", uptime_seconds AS \"Uptime\", timestamp AS \"Reported\"\nFROM all_vms ORDER BY CASE WHEN vm LIKE 'server%' THEN 0 WHEN vm = 'database' THEN 1 WHEN vm = 'storage' THEN 2 WHEN vm = 'frontend' THEN 3 WHEN vm = 'proxy' THEN 4 WHEN vm = 'monitoring' THEN 5 ELSE 9 END, vm",
          "refId": "A"
        }
      ]
