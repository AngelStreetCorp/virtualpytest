      "interval": "5m",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(timestamp, $__interval), vm AS metric, avg(cpu_percent)::float AS value\nFROM vm_metrics WHERE $__timeFilter(timestamp) AND server_name = ANY(string_to_array('${collector:csv}', ','))\nGROUP BY 1, 2\nUNION ALL\nSELECT $__timeGroupAlias(timestamp, $__interval), 'server · ' || server_name AS metric, avg(cpu_percent)::float AS value\nFROM system_metrics WHERE $__timeFilter(timestamp) AND host_name = 'server' AND server_name = ANY(string_to_array('${collector:csv}', ','))\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ]
    },
