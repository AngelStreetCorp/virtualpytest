      "panels": [
        {
          "type": "state-timeline",
          "title": "Status over time",
          "id": 15,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "description": "Built from the change log: each status lasts until the next change. Reports that stopped for 3+ minutes are recorded as DOWN (no report).",
          "gridPos": {
            "h": 16,
            "w": 24,
            "x": 0,
            "y": 38
          },
          "fieldConfig": {
            "defaults": {
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
