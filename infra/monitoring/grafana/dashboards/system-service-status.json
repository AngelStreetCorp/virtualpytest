        {
          "type": "table",
          "title": "Availability over the selected range",
          "id": 16,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "description": "Time OK ÷ time observed in the range, from the change log. Time without reports counts as down; STOPPED (switched off) and UNKNOWN time are left out.",
