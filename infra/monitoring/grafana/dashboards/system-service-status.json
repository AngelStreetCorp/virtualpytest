            }
          },
          "targets": [
            {
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "supabase-postgres"
              },
              "format": "time_series",
              "rawQuery": true,
              "editorMode": "code",
              "rawSql": "WITH keys AS (\n  SELECT server_name, vm, component FROM service_status_current WHERE server_name = ANY(string_to_array('${collector:csv}', ','))\n), points AS (\n  -- the status each component was in when the range starts\n  SELECT $__timeFrom()::timestamptz AS time, CASE WHEN k.vm = 'server' THEN 'server · ' || k.server_name ELSE k.vm END || ' / ' || k.component AS metric, b.code AS value\n  FROM keys k CROSS JOIN LATERAL (\n    SELECT CASE status WHEN 'ok' THEN 0 WHEN 'stopped' THEN 1 WHEN 'unknown' THEN 2 WHEN 'degraded' THEN 3 ELSE 4 END AS code FROM service_status s\n    WHERE s.server_name = k.server_name AND s.vm = k.vm AND s.component = k.component\n      AND s.checked_at <= $__timeFrom()\n    ORDER BY s.checked_at DESC LIMIT 1) b\n  UNION ALL\n  -- every change inside the range\n  SELECT checked_at, CASE WHEN vm = 'server' THEN 'server · ' || server_name ELSE vm END || ' / ' || component, CASE status WHEN 'ok' THEN 0 WHEN 'stopped' THEN 1 WHEN 'unknown' THEN 2 WHEN 'degraded' THEN 3 ELSE 4 END\n  FROM service_status WHERE $__timeFilter(checked_at) AND server_name = ANY(string_to_array('${collector:csv}', ','))\n  UNION ALL\n  -- where it is now (stale = down)\n  SELECT LEAST(now(), $__timeTo()::timestamptz), CASE WHEN vm = 'server' THEN 'server · ' || server_name ELSE vm END || ' / ' || component,\n         CASE WHEN checked_at < now() - interval '3 minutes' THEN 4 ELSE CASE status WHEN 'ok' THEN 0 WHEN 'stopped' THEN 1 WHEN 'unknown' THEN 2 WHEN 'degraded' THEN 3 ELSE 4 END END\n  FROM service_status_current WHERE server_name = ANY(string_to_array('${collector:csv}', ','))\n)\nSELECT time, metric, max(value) AS value FROM points GROUP BY 1, 2 ORDER BY 1",
              "refId": "A"
            }
