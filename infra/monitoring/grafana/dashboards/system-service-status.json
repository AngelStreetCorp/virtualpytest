      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH current AS (\n  SELECT server_name, vm, component, status, detail, checked_at, since,\n         CASE WHEN checked_at < now() - interval '3 minutes' THEN 'STALE' ELSE upper(status) END AS state\n  FROM service_status_current WHERE server_name = ANY(string_to_array('${collector:csv}', ','))\n)\nSELECT CASE WHEN vm = 'server' THEN 'server · ' || server_name ELSE vm END AS \"VM\", component AS \"Component\", state AS \"Status\",\n       CASE WHEN state = 'STALE' THEN 'no report for ' || floor(extract(epoch FROM now() - checked_at) / 60)::int || ' min — last: ' || coalesce(detail, '')\n            ELSE detail END AS \"Detail\",\n       since AS \"Since\", checked_at AS \"Last check\", server_name AS \"Collector\"\nFROM current\nORDER BY CASE state WHEN 'STALE' THEN 0 WHEN 'DOWN' THEN 1 WHEN 'DEGRADED' THEN 2 WHEN 'UNKNOWN' THEN 3 WHEN 'STOPPED' THEN 4 ELSE 5 END,\n         CASE WHEN vm LIKE 'server%' THEN 0 WHEN vm = 'database' THEN 1 WHEN vm = 'storage' THEN 2 WHEN vm = 'frontend' THEN 3 WHEN vm = 'proxy' THEN 4 WHEN vm = 'monitoring' THEN 5 ELSE 9 END, vm, component",
          "refId": "A"
        }
      ]
