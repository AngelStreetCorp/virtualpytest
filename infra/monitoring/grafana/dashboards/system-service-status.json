              }
            ]
          },
          "options": {
            "showHeader": true,
            "cellHeight": "sm",
            "sortBy": [
              {
                "displayName": "Availability %",
                "desc": false
              }
            ],
            "footer": {
              "show": false,
              "reducer": [
                "sum"
              ],
              "fields": ""
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "supabase-postgres"
              },
              "format": "table",
              "rawQuery": true,
              "editorMode": "code",
              "rawSql": "WITH events AS (\n  SELECT server_name, vm, component, checked_at AS t, status, detail\n  FROM service_status WHERE server_name = ANY(string_to_array('${collector:csv}', ',')) AND checked_at < $__timeTo()\n  UNION ALL\n  -- a component that stopped reporting is down from one minute after its last report\n  SELECT server_name, vm, component, checked_at + interval '1 minute', 'down', 'no report'\n  FROM service_status_current WHERE server_name = ANY(string_to_array('${collector:csv}', ',')) AND checked_at < now() - interval '3 minutes'\n), spans AS (\n  SELECT server_name, vm, component, status,\n         GREATEST(t, $__timeFrom()::timestamptz) AS a,\n         LEAST(COALESCE(lead(t) OVER (PARTITION BY server_name, vm, component ORDER BY t), now()),\n               $__timeTo()::timestamptz, now()) AS b\n  FROM events\n), secs AS (\n  SELECT CASE WHEN vm = 'server' THEN 'server · ' || server_name ELSE vm END AS vm, component, status, extract(epoch FROM b - a) AS s FROM spans WHERE b > a AND status NOT IN ('unknown', 'stopped')\n)\nSELECT vm AS \"VM\", component AS \"Component\",\n       round((100.0 * coalesce(sum(s) FILTER (WHERE status = 'ok'), 0) / NULLIF(sum(s), 0))::numeric, 2) AS \"Availability %\",\n       round((coalesce(sum(s) FILTER (WHERE status <> 'ok'), 0) / 60)::numeric) AS \"Minutes not OK\",\n       count(*) FILTER (WHERE status <> 'ok') AS \"Times not OK\"\nFROM secs GROUP BY vm, component\nORDER BY 3, CASE WHEN vm LIKE 'server%' THEN 0 WHEN vm = 'database' THEN 1 WHEN vm = 'storage' THEN 2 WHEN vm = 'frontend' THEN 3 WHEN vm = 'proxy' THEN 4 WHEN vm = 'monitoring' THEN 5 ELSE 9 END, vm, component",
              "refId": "A"
            }
          ]
        },
