              "rawQuery": true,
              "editorMode": "code",
              "rawSql": "SELECT checked_at AS \"Time\", CASE WHEN vm = 'server' THEN 'server · ' || server_name ELSE vm END AS \"VM\", component AS \"Component\", upper(status) AS \"Status\",\n       detail AS \"Detail\", server_name AS \"Collector\"\nFROM service_status WHERE $__timeFilter(checked_at) AND server_name = ANY(string_to_array('${collector:csv}', ','))\nORDER BY checked_at DESC LIMIT 500",
