          "rawSql": "WITH latest AS (\n  SELECT DISTINCT ON (script_name) script_name, success\n  FROM script_results\n  WHERE team_id='7fdeb4bb-3639-4ec3-959f-b54769a219ce'\n    AND (userinterface_name = 'virtualpytest_web' OR script_name LIKE 'smoke\\_%') AND $__timeFilter(started_at)\n  ORDER BY script_name, started_at DESC\n)\nSELECT\n  CASE WHEN success THEN 'Pass' ELSE 'Fail' END as \"Status\",\n  COUNT(*) as \"Count\"\nFROM latest\nGROUP BY success\nORDER BY success DESC",
