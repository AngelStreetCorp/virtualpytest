      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH scope AS (\n  SELECT script_name, success, started_at, execution_time_ms, host_name, html_report_r2_url\n  FROM script_results\n  WHERE team_id='7fdeb4bb-3639-4ec3-959f-b54769a219ce' AND (userinterface_name = 'virtualpytest_web' OR script_name LIKE 'smoke\\_%')\n    AND (host_name IN ($host) OR host_name IS NULL)\n),\nwin AS (\n  SELECT * FROM scope WHERE $__timeFilter(started_at)\n),\nlast AS (\n  SELECT DISTINCT ON (script_name) script_name, started_at, success, execution_time_ms, host_name, html_report_r2_url\n  FROM scope ORDER BY script_name, started_at DESC\n)\nSELECT\n  l.script_name AS \"Script\",\n  l.started_at AS \"Last Run\",\n  CASE WHEN l.success THEN 'PASS' ELSE 'FAIL' END AS \"Last Result\",\n  l.execution_time_ms AS \"Last Duration\",\n  l.host_name AS \"Host\",\n  COUNT(w.script_name) AS \"Runs (window)\",\n  SUM(CASE WHEN w.success THEN 1 ELSE 0 END) AS \"Pass (window)\",\n  ROUND(SUM(CASE WHEN w.success THEN 1 ELSE 0 END)::numeric / NULLIF(COUNT(w.script_name), 0) * 100, 1) AS \"Pass % (window)\",\n  CASE WHEN l.html_report_r2_url IS NOT NULL THEN '<a href=\"' || l.html_report_r2_url || '\" target=\"_blank\">report</a>' END AS \"Last Report\"\nFROM last l\nLEFT JOIN win w USING (script_name)\nGROUP BY l.script_name, l.started_at, l.success, l.execution_time_ms, l.host_name, l.html_report_r2_url\nORDER BY l.started_at DESC",
          "refId": "A"
        }
      ],
      "title": "Scripts — last result, pass % and runs in selected window",
      "type": "table",
      "description": "One row per script recorded under virtualpytest_web. Last Run/Result/Report are all-time; Runs/Pass % are limited to the dashboard time range and Host filter."
