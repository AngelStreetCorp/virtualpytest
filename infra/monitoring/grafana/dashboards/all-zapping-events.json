      "pluginVersion": "12.1.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  zr.created_at as \"Detected At\",\n  zr.device_name as \"Device\",\n  zr.userinterface_name as \"Source\",\n  scr.script_name as \"Script\",\n  NULLIF(zr.action_params->>'display_name', '') as \"Name\",\n  zr.channel_name as \"Channel\",\n  zr.program_name as \"Program\",\n  CONCAT(zr.program_start_time, '-', zr.program_end_time) as \"Program Time\",\n  zr.detection_method as \"Detection\",\n  COALESCE(zr.action_params->>'key', zr.action_command) as \"Last Action\",\n  NULLIF(zr.action_params->>'channel', '') as \"Channel Input\",\n  ROUND((zr.blackscreen_freeze_duration_seconds * 1000)::numeric, 0) as \"BS Duration (ms)\",\n  zr.time_since_action_ms as \"Action Delay (ms)\",\n  zr.total_zap_duration_ms as \"Total Zap (ms)\",\n  ROUND(zr.audio_silence_duration::numeric, 2) as \"Audio Silence (s)\",\n  CASE WHEN scr.html_report_r2_url IS NOT NULL AND scr.html_report_r2_url != ''\n       THEN '<a href=\"' || scr.html_report_r2_url || '\" target=\"_blank\">link</a>'\n       ELSE '' END as \"Script Report\",\n  CASE WHEN zr.report_url IS NOT NULL AND zr.report_url != ''\n       THEN '<a href=\"' || zr.report_url || '\" target=\"_blank\">link</a>'\n       ELSE '' END as \"KPI Report\"\nFROM (\n  -- Limit BEFORE enrichment: otherwise the LATERAL below runs for every row\n  -- in the time range and the result is then thrown away by the LIMIT.\n  SELECT * FROM (SELECT * FROM zap_results WHERE ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = zap_results.host_name AND df.device_name = zap_results.device_name AND df.flags && string_to_array('${flag:csv}', ','))) AND (zap_results.script_result_id IS NULL OR EXISTS (SELECT 1 FROM script_results sr_env WHERE sr_env.id = zap_results.script_result_id AND sr_env.environment IN ($environment)))) zap_results\n  WHERE $__timeFilter(created_at)\n  ORDER BY created_at DESC\n  LIMIT 200\n) zr\n-- Automatic zaps store script_result_id = NULL (zapping_detector_utils hardcodes it),\n-- so the driving script is recovered by time overlap: the script running on this\n-- host+device when the zap was detected. NULL = genuinely autonomous monitor zap.\nLEFT JOIN LATERAL (\n  SELECT sr.script_name, sr.html_report_r2_url FROM script_results sr\n  WHERE sr.host_name = zr.host_name\n    AND sr.device_name = zr.device_name\n    -- Bound the backward scan. Without this, a zap with no overlapping script (the\n    -- common case \u2014 most zaps are autonomous) walks EVERY script_results row for\n    -- that host+device before concluding there is no match. Longest observed run is\n    -- ~39 min, so 6h is a wide margin; a longer run than that is simply unattributed.\n    AND sr.started_at >= zr.created_at - interval '6 hours'\n    AND zr.created_at BETWEEN sr.started_at AND sr.completed_at\n  ORDER BY sr.started_at DESC LIMIT 1\n) scr ON true\nORDER BY zr.created_at DESC",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          },
          "table": "zap_results"
        }
      ],
      "title": "Automatic Zapping Events",
      "type": "table"
    },
