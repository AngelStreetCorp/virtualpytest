              "rawQuery": true,
              "rawSql": "SELECT\n  sr.started_at as \"Started At\",\n  sr.host_name as \"Roboter\",\n  sr.device_name as \"Device\",\n  sr.userinterface_name as \"User Interface\",\n  sr.script_name as \"Script\",\n  sr.execution_time_ms as \"Duration (ms)\",\n  sr.error_msg as \"Error\",\n  CASE WHEN sr.html_report_r2_url IS NOT NULL AND sr.html_report_r2_url != ''\n       THEN '<a href=\"' || sr.html_report_r2_url || '\" target=\"_blank\">link</a>'\n       ELSE '' END as \"Script Report\"\nFROM script_results sr\nWHERE sr.script_name ILIKE '%zap%'\n  AND sr.success IS DISTINCT FROM true\n  AND ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = sr.host_name AND df.device_name = sr.device_name AND df.flags && string_to_array('${flag:csv}', ',')))\n  AND $__timeFilter(sr.started_at)\n  AND sr.environment IN ($environment)\nORDER BY sr.started_at DESC",
