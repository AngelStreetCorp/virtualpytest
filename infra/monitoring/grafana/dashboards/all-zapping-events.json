      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  CASE\n    WHEN NULLIF(zr.action_params->>'channel', '') IS NOT NULL\n      THEN 'Channel ' || (zr.action_params->>'channel')\n    ELSE COALESCE(zr.action_params->>'key', zr.action_command)\n  END as \"Zap Target\",\n  ROUND(AVG(zr.total_zap_duration_ms)::numeric, 2) as \"Mean Zap Duration\"\nFROM (SELECT * FROM zap_results WHERE ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = zap_results.host_name AND df.device_name = zap_results.device_name AND df.flags && string_to_array('${flag:csv}', ','))) AND (zap_results.script_result_id IS NULL OR EXISTS (SELECT 1 FROM script_results sr_env WHERE sr_env.id = zap_results.script_result_id AND sr_env.environment IN ($environment)))) zr\nWHERE $__timeFilter(zr.created_at)\n  AND zr.total_zap_duration_ms IS NOT NULL\n  AND (\n    -- Direct channel entry \u2014 one group per target channel.\n    NULLIF(zr.action_params->>'channel', '') IS NOT NULL\n    -- Relative zapping \u2014 one group each.\n    OR COALESCE(zr.action_params->>'key', zr.action_command) IN ('CHANNEL_UP', 'CHANNEL_DOWN')\n  )\nGROUP BY 1\nORDER BY \"Mean Zap Duration\" DESC",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
      ],
      "title": "Mean Zap Duration by Zap Target",
      "type": "barchart"
