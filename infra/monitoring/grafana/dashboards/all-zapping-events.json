      "pluginVersion": "12.3.2",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  (SELECT COUNT(*)\n   FROM zap_results zr\n   WHERE ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = zr.host_name AND df.device_name = zr.device_name AND df.flags && string_to_array('${flag:csv}', ',')))\n     AND $__timeFilter(zr.created_at)) AS \"Total Zaps\",\n  COUNT(*) FILTER (WHERE success IS DISTINCT FROM true) AS \"Failures\",\n  ROUND((COUNT(CASE WHEN success = true THEN 1 END)::numeric / NULLIF(COUNT(*), 0)) * 100, 2) AS \"Success Rate\"\nFROM script_results sr\nWHERE sr.script_name ILIKE '%zap%'\n  AND ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = sr.host_name AND df.device_name = sr.device_name AND df.flags && string_to_array('${flag:csv}', ',')))\n  AND $__timeFilter(sr.started_at)\n  AND sr.environment IN ($environment)",
          "refId": "A"
        }
      ],
      "title": "",
      "type": "stat",
      "description": "Total Zaps counts detected zap events (zap_results). Failures / Success Rate count zap script runs (script_results): a run fails when the script ends without zapping detected \u2014 failed iterations are never written to zap_results, so the script verdict is the only recorded failure signal."
    },
