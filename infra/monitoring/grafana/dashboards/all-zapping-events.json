        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(t.ts, '30m'),\n  COUNT(*) FILTER (WHERE t.kind = 'zap') AS \"Zaps\",\n  COUNT(*) FILTER (WHERE t.kind = 'failed_run') AS \"Failed\"\nFROM (\n  SELECT zr.created_at AS ts, 'zap' AS kind\n  FROM zap_results zr\n  WHERE ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = zr.host_name AND df.device_name = zr.device_name AND df.flags && string_to_array('${flag:csv}', ','))) \n    AND $__timeFilter(zr.created_at)\n    AND (zr.script_result_id IS NULL OR EXISTS (SELECT 1 FROM script_results sr_env WHERE sr_env.id = zr.script_result_id AND sr_env.environment IN ($environment)))\n  UNION ALL\n  SELECT sr.started_at, 'failed_run'\n  FROM script_results sr\n  WHERE sr.script_name ILIKE '%zap%'\n    AND sr.success IS DISTINCT FROM true\n    AND ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = sr.host_name AND df.device_name = sr.device_name AND df.flags && string_to_array('${flag:csv}', ',')))\n    AND $__timeFilter(sr.started_at)\n    AND sr.environment IN ($environment)\n) t\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Global Activity",
      "type": "timeseries",
      "transparent": true
    },
