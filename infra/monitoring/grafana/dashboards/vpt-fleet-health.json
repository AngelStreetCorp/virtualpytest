      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "uid": "supabase-postgres" }, "format": "table", "rawSql": "SELECT count(*) AS \"DEGRADED\" FROM fleet_health WHERE generated_at = (SELECT max(generated_at) FROM fleet_health) AND verdict = 'DEGRADED' AND host_name = ANY(string_to_array('${host:csv}', ','))", "refId": "A" } ],
      "title": "DEGRADED",
