      "targets": [ { "datasource": { "uid": "supabase-postgres" }, "format": "table", "rawSql": "SELECT count(*) AS \"OK\" FROM fleet_health WHERE generated_at = (SELECT max(generated_at) FROM fleet_health) AND verdict = 'OK' AND host_name = ANY(string_to_array('${host:csv}', ','))", "refId": "A" } ],
      "title": "OK",
