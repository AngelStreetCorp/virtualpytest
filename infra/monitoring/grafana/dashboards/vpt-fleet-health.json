    },
    {
      "datasource": { "uid": "supabase-postgres" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "red", "mode": "fixed" }, "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "uid": "supabase-postgres" }, "format": "table", "rawSql": "SELECT count(*) AS \"DOWN\" FROM fleet_health WHERE generated_at = (SELECT max(generated_at) FROM fleet_health) AND verdict = 'DOWN' AND host_name = ANY(string_to_array('${host:csv}', ','))", "refId": "A" } ],
      "title": "DOWN",
      "type": "stat"
    },
    {
      "datasource": { "uid": "supabase-postgres" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "text", "mode": "fixed" }, "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "uid": "supabase-postgres" }, "format": "table", "rawSql": "SELECT count(*) AS \"UNKNOWN\" FROM fleet_health WHERE generated_at = (SELECT max(generated_at) FROM fleet_health) AND verdict = 'UNKNOWN' AND host_name = ANY(string_to_array('${host:csv}', ','))", "refId": "A" } ],
      "title": "UNKNOWN",
      "type": "stat"
    },
    {
      "datasource": { "uid": "supabase-postgres" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "dateTimeFromNow" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": { "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "datasource": { "uid": "supabase-postgres" }, "format": "table", "rawSql": "SELECT max(generated_at) AS \"Last run\" FROM fleet_health", "refId": "A" } ],
      "title": "Last run",
      "type": "stat"
    },
    {
      "datasource": { "uid": "supabase-postgres" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Verdict" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [ { "type": "value", "options": {
                  "OK": { "color": "green", "index": 0 },
                  "IDLE": { "color": "blue", "index": 1 },
                  "DEGRADED": { "color": "orange", "index": 2 },
                  "DOWN": { "color": "red", "index": 3 },
                  "UNKNOWN": { "color": "text", "index": 4 } } } ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Report" },
            "properties": [ { "id": "custom.cellOptions", "value": { "type": "markdown" } }, { "id": "custom.width", "value": 80 } ]
          },
          { "matcher": { "id": "byName", "options": "Reason" }, "properties": [ { "id": "custom.width", "value": 420 } ] },
          { "matcher": { "id": "byName", "options": "Issue since" }, "properties": [ { "id": "unit", "value": "dateTimeAsIso" } ] }
        ]
      },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 4 },
      "id": 7,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true, "sortBy": [] },
      "targets": [
        {
          "datasource": { "uid": "supabase-postgres" },
          "format": "table",
          "rawSql": "SELECT f.host_name AS \"Host\", COALESCE(f.device_name, f.device_id) AS \"Device\", f.device_model AS \"Model\", f.verdict AS \"Verdict\", f.issue_since AS \"Issue since\", f.reason AS \"Reason\", COALESCE(f.ai_analysis, '') AS \"AI analysis\", CASE WHEN f.last_script_name IS NOT NULL THEN (CASE WHEN f.last_script_success THEN '✅ ' ELSE '❌ ' END) || f.last_script_name ELSE '—' END AS \"Last script\", CASE WHEN f.report_url IS NOT NULL THEN '<a href=\"' || f.report_url || '\" target=\"_blank\">open</a>' ELSE '' END AS \"Report\" FROM fleet_health f WHERE f.generated_at = (SELECT max(generated_at) FROM fleet_health) AND f.host_name = ANY(string_to_array('${host:csv}', ',')) ORDER BY f.host_name, f.device_id",
          "refId": "A"
        }
      ],
      "title": "Latest run — per device",
      "type": "table"
    },
    {
      "datasource": { "uid": "supabase-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "bars", "fillOpacity": 80, "stacking": { "group": "A", "mode": "normal" } },
          "unit": "none"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "OK" }, "properties": [ { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } } ] },
          { "matcher": { "id": "byName", "options": "IDLE" }, "properties": [ { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } } ] },
          { "matcher": { "id": "byName", "options": "DEGRADED" }, "properties": [ { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } } ] },
          { "matcher": { "id": "byName", "options": "DOWN" }, "properties": [ { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } } ] },
          { "matcher": { "id": "byName", "options": "UNKNOWN" }, "properties": [ { "id": "color", "value": { "fixedColor": "text", "mode": "fixed" } } ] }
        ]
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "uid": "supabase-postgres" },
          "format": "time_series",
          "rawSql": "SELECT generated_at AS time, verdict AS metric, count(*)::float AS value FROM fleet_health WHERE $__timeFilter(generated_at) AND host_name = ANY(string_to_array('${host:csv}', ',')) GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Fleet verdicts over time",
      "type": "timeseries"
    },
    {
      "datasource": { "uid": "supabase-postgres" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Verdict" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [ { "type": "value", "options": {
                  "OK": { "color": "green", "index": 0 },
                  "IDLE": { "color": "blue", "index": 1 },
                  "DEGRADED": { "color": "orange", "index": 2 },
                  "DOWN": { "color": "red", "index": 3 },
                  "UNKNOWN": { "color": "text", "index": 4 } } } ] }
            ]
          },
          { "matcher": { "id": "byName", "options": "Time" }, "properties": [ { "id": "unit", "value": "dateTimeAsIso" } ] }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "id": 9,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true, "sortBy": [ { "desc": true, "displayName": "Time" } ] },
      "targets": [
        {
          "datasource": { "uid": "supabase-postgres" },
          "format": "table",
          "rawSql": "SELECT f.generated_at AS \"Time\", f.host_name AS \"Host\", COALESCE(f.device_name, f.device_id) AS \"Device\", f.verdict AS \"Verdict\", f.issue_since AS \"Issue since\", f.reason AS \"Reason\", COALESCE(f.ai_analysis, '') AS \"AI analysis\" FROM fleet_health f WHERE $__timeFilter(f.generated_at) AND f.verdict IN ('DEGRADED', 'DOWN', 'UNKNOWN') AND f.host_name = ANY(string_to_array('${host:csv}', ',')) ORDER BY f.generated_at DESC, f.host_name, f.device_id LIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Needs attention — history (DEGRADED / DOWN / UNKNOWN)",
      "type": "table"
    }
  ],
