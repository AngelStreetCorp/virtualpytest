              "rawSql": "SELECT \n  CONCAT(host_name, '-', device_id) as device,\n  COALESCE('[' || (metadata->'script_identity'->>'prefix') || '] ' || (metadata->'script_identity'->>'display_name'),metadata->'script_identity'->>'display_name','[' || (metadata->'script_identity'->>'prefix') || '] ' || script_name,script_name) as task,\n  (jsonb_array_elements(scheduled_today)->>'start')::timestamptz as start,\n  (jsonb_array_elements(scheduled_today)->>'end')::timestamptz as end,\n  status\nFROM (SELECT * FROM deployments /*device-scope*/ WHERE ('*' = ANY(string_to_array(${allowed_devices:sqlstring}, '|')) OR host_name || ':' || device_id = ANY(string_to_array(${allowed_devices:sqlstring}, '|')))) deployments\nWHERE status = 'active'\n  AND scheduled_today IS NOT NULL\n  AND ('${host:csv}' = '' OR host_name IN ($host))\nORDER BY device, start\nLIMIT 1800",
