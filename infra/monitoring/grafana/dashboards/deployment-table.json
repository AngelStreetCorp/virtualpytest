              "rawQuery": true,
              "rawSql": "SELECT \n  CONCAT(host_name, '-', device_name) as device,\n  COALESCE('[' || (metadata->'script_identity'->>'prefix') || '] ' || (metadata->'script_identity'->>'display_name'),metadata->'script_identity'->>'display_name','[' || (metadata->'script_identity'->>'prefix') || '] ' || script_name,script_name) as \"Script Name\",\n  started_at,\n  completed_at,\n  success,\n  EXTRACT(EPOCH FROM (completed_at - started_at)) as duration_seconds\nFROM (SELECT * FROM script_results /*device-scope*/ WHERE ('*' = ANY(string_to_array(${allowed_devices:sqlstring}, '|')) OR host_name || ':' || device_name = ANY(string_to_array(${allowed_devices:sqlstring}, '|')))) script_results \nWHERE $__timeFilter(started_at)\n  AND ('${user_interface:csv}' = '' OR userinterface_name IN ($user_interface))\n  AND ('${host:csv}' = '' OR host_name IN ($host))\n  AND ('${device_name:csv}' = '' OR device_name IN ($device_name))\nORDER BY device, started_at\nLIMIT 50",
