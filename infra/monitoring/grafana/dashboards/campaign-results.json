          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(*) AS \"Campaign Runs\",\n  COUNT(*) FILTER (WHERE ce.success = false) AS \"Failed\",\n  ROUND((COUNT(*) FILTER (WHERE ce.success = true)::decimal / NULLIF(COUNT(*),0)) * 100, 1) AS \"Success Rate\",\n  ROUND(SUM(ce.execution_time_ms)::decimal / 1000 / 60, 3) AS \"Total Time (min)\",\n  ROUND(AVG(ce.execution_time_ms)::decimal / 1000, 1) AS \"Avg Duration (s)\"FROM (SELECT * FROM campaign_executions WHERE ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = campaign_executions.host_name AND df.device_name = campaign_executions.device_name AND df.flags && string_to_array('${flag:csv}', ','))) AND (campaign_executions.script_result_ids IS NULL OR EXISTS (SELECT 1 FROM script_results sr_env WHERE sr_env.id = ANY(campaign_executions.script_result_ids) AND sr_env.environment IN ($environment)))) ce\nWHERE $__timeFilter(ce.started_at)\n  AND (ce.campaign_name IN ($campaign_name) OR ce.campaign_name IS NULL)\n  AND (ce.host_name IN ($host) OR ce.host_name IS NULL)\n  AND (ce.device_name IN ($device_name) OR ce.device_name IS NULL)\n  AND (ce.userinterface_name IN ($user_interface) OR ce.userinterface_name IS NULL)\n  AND ce.success::text IN ($success)",
          "refId": "A"
        }
      ],
