          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(ce.started_at, '1d') AS time,\n  COALESCE(ce.campaign_name, 'No Campaign') AS metric,\n  ROUND((SUM(CASE WHEN ce.success THEN 1 ELSE 0 END)::decimal / NULLIF(COUNT(*), 0)) * 100, 1) AS value\nFROM (SELECT * FROM campaign_executions WHERE ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = campaign_executions.host_name AND df.device_name = campaign_executions.device_name AND df.flags && string_to_array('${flag:csv}', ','))) AND (campaign_executions.script_result_ids IS NULL OR EXISTS (SELECT 1 FROM script_results sr_env WHERE sr_env.id = ANY(campaign_executions.script_result_ids) AND sr_env.environment IN ($environment)))) ce\nWHERE $__timeFilter(ce.started_at)\n  AND (ce.campaign_name IN ($campaign_name) OR ce.campaign_name IS NULL)\n  AND (ce.host_name IN ($host) OR ce.host_name IS NULL)\n  AND (ce.device_name IN ($device_name) OR ce.device_name IS NULL)\n  AND (ce.userinterface_name IN ($user_interface) OR ce.userinterface_name IS NULL)\n  AND ce.success::text IN ($success)\nGROUP BY time, ce.campaign_name\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Success Trend Over Time per Campaign",
      "type": "timeseries"
