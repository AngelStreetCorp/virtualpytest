              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT\n  ce.campaign_name AS \"Campaign\",\n  ce.campaign_execution_id AS \"Run ID\",\n  COALESCE('[' || (sr.metadata->'script_identity'->>'prefix') || '] ' || (sr.metadata->'script_identity'->>'display_name'),sr.metadata->'script_identity'->>'display_name','[' || (sr.metadata->'script_identity'->>'prefix') || '] ' || sr.script_name,sr.script_name) as \"Script\",\n  sr.host_name AS \"Host\",\n  sr.device_name AS \"Device\",\n  sr.success AS \"Success\",\n  sr.started_at,\n  sr.completed_at,\n  sr.execution_time_ms,\n  sr.html_report_r2_url,\n  sr.logs_r2_url,\n  sr.error_msg\nFROM script_results sr\nJOIN (SELECT * FROM campaign_executions WHERE ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = campaign_executions.host_name AND df.device_name = campaign_executions.device_name AND df.flags && string_to_array('${flag:csv}', ',')))) ce\n  ON sr.id = ANY(ce.script_result_ids)\nWHERE $__timeFilter(sr.started_at)\n  AND (ce.campaign_name IN ($campaign_name) OR ce.campaign_name IS NULL)\n  AND (ce.host_name IN ($host) OR ce.host_name IS NULL)\n  AND (ce.device_name IN ($device_name) OR ce.device_name IS NULL)\n  AND (ce.userinterface_name IN ($user_interface) OR ce.userinterface_name IS NULL)\n  AND ce.success::text IN ($success)\n  AND sr.environment IN ($environment)\nORDER BY sr.started_at DESC\nLIMIT 1000",
              "refId": "A"
            }
