        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH ident AS (\n  SELECT DISTINCT ON (name) regexp_replace(script_ref, '^.*/', '') as name, prefix, display_name\n  FROM executable_identity WHERE kind = 'script'\n  ORDER BY name, updated_at DESC\n)\nSELECT \n  $__timeGroup(started_at, '1d') as time,\n  COALESCE('[' || i.prefix || '] ' || i.display_name, i.display_name, script_name, 'No Script') as metric,\n  ROUND((SUM(CASE WHEN success THEN 1 ELSE 0 END)::decimal / COUNT(*)) * 100, 1) as value\nFROM (SELECT * FROM script_results WHERE ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = script_results.host_name AND df.device_name = script_results.device_name AND df.flags && string_to_array('${flag:csv}', ',')))) script_results \nLEFT JOIN ident i ON i.name = script_results.script_name\nWHERE $__timeFilter(started_at)\n  AND (userinterface_name IN ($user_interface) OR userinterface_name IS NULL)\n  AND (host_name IN ($host) OR host_name IS NULL)\n  AND (device_name IN ($device_name) OR device_name IS NULL)\n  AND script_name IN ($script_name)\n  AND success::text IN ($success)\n  AND COALESCE(metadata->>'variant', 'base') IN ($variant)\n  AND environment IN ($environment)\nGROUP BY time, script_name, i.prefix, i.display_name\nORDER BY time",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Success Trend Over Time per Script",
      "type": "timeseries"
    },
