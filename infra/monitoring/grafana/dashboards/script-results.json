              "rawQuery": true,
              "rawSql": "SELECT COALESCE('[' || (metadata->'script_identity'->>'prefix') || '] ' || (metadata->'script_identity'->>'display_name'),metadata->'script_identity'->>'display_name','[' || (metadata->'script_identity'->>'prefix') || '] ' || script_name,script_name) as \"Script\", userinterface_name as \"Userinterface\", CASE WHEN userinterface_name IS NOT NULL THEN COALESCE(metadata->>'variant', 'base') END as \"Variant\", host_name as \"Host\", device_name as \"Device\", success, started_at, completed_at, execution_time_ms, ('<a href=\"' || html_report_r2_url || '\" target=\"_blank\">report</a>') AS html_report_r2_url, ('<a href=\"' || logs_r2_url || '\" target=\"_blank\">logs</a>') AS logs_r2_url, error_msg, metadata \nFROM (SELECT * FROM script_results WHERE ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = script_results.host_name AND df.device_name = script_results.device_name AND df.flags && string_to_array('${flag:csv}', ',')))) script_results \nWHERE $__timeFilter(started_at)\n  AND (userinterface_name IN ($user_interface) OR userinterface_name IS NULL)\n  AND (host_name IN ($host) OR host_name IS NULL)\n  AND (device_name IN ($device_name) OR device_name IS NULL)\n  AND script_name IN ($script_name)\n  AND success::text IN ($success)\n  AND COALESCE(metadata->>'variant', 'base') IN ($variant)\n  AND environment IN ($environment)\nORDER BY started_at DESC \nLIMIT 500",
