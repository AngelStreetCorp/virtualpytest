        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(*) as \"Nr. of total test\",\n  COUNT(*) FILTER (WHERE success = false) as \"Nr. of failed test\",\n  ROUND((COUNT(*) FILTER (WHERE success = true)::decimal / NULLIF(COUNT(*),0)) * 100, 1) as \"Success Rate\",\n  ROUND(SUM(execution_time_ms)::decimal / 1000 / 60, 3) as \"Total Time (min)\",\n  ROUND(AVG(execution_time_ms)::decimal / 1000, 1) as \"Avg Duration (s)\"FROM (SELECT * FROM script_results WHERE ('${flag}' = '__ALL__' OR EXISTS (SELECT 1 FROM device_flags df WHERE df.host_name = script_results.host_name AND df.device_name = script_results.device_name AND df.flags && string_to_array('${flag:csv}', ',')))) script_results WHERE $__timeFilter(started_at) AND (userinterface_name IN ($user_interface) OR userinterface_name IS NULL) AND (host_name IN ($host) OR host_name IS NULL) AND (device_name IN ($device_name) OR device_name IS NULL) AND script_name IN ($script_name)\n  AND success::text IN ($success)\n  AND COALESCE(metadata->>'variant', 'base') IN ($variant)\n  AND environment IN ($environment)",
          "refId": "A"
        }
      ],
      "title": "",
      "type": "stat"
