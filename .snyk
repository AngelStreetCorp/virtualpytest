# Snyk (https://snyk.io) policy file.
#
# Applied twice:
#   1. by the Snyk CLI when `snyk code test` runs from the repo root, and
#   2. by scripts/parse-security-to-html.py, which drops matching findings from the
#      committed dashboard (docs/security/index.html) and shows them as "ignored".
# Paths are relative to the repo root.
version: v1.25.0
ignore:
  # Snyk flags "unsanitized input flows into the return value" on every Flask route
  # that ends in `return jsonify(...)`. jsonify sets Content-Type: application/json,
  # which browsers never render as HTML, so the response cannot carry a reflected XSS.
  # Only the files below (all-JSON proxy routes) are ignored; routes that really return
  # text/html (navigation tree export, api-testing report, security docs, host stream
  # index) are deliberately NOT listed so a real finding there still surfaces.
  'python/XSS':
    - 'backend_host/src/routes/host_av_routes.py':
        reason: JSON-only responses (jsonify) — not rendered as HTML
        created: 2026-09-07T00:00:00.000Z
    - 'backend_server/src/routes/auto_proxy.py':
        reason: JSON-only responses (jsonify) — not rendered as HTML
        created: 2026-09-07T00:00:00.000Z
    - 'backend_server/src/routes/server_actions_routes.py':
        reason: JSON-only responses (jsonify) — not rendered as HTML
        created: 2026-09-07T00:00:00.000Z
