# NOTE: This is a template file for reference only.
# The actual service file is generated by setup/local/linux/backend_host/install_host.sh
# with correct dynamic paths for your system.
# Renamed from: novnc.service → websockify.service (aligned with macOS)

[Unit]
Description=VirtualPyTest noVNC websockify service
After=network.target vnc.service

[Service]
Type=simple
User=vpt_user
Group=vpt_user
WorkingDirectory=/usr/share/novnc
# With SSL (optional): ExecStart=/usr/bin/websockify --web /usr/share/novnc --cert=%WEBSOCKIFY_CERT% 0.0.0.0:6080 localhost:5901
ExecStart=/usr/bin/websockify --web /usr/share/novnc 0.0.0.0:6080 localhost:5901
Restart=on-failure
RestartSec=5

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
