# NOTE: This is a template file for reference only.
# The actual service file is generated by setup/local/linux/backend_host/install_host.sh
# with correct dynamic paths for your system.
# Renamed from: transcript-stream.service → transcript.service (aligned with macOS)
#
# TRANSCRIPTION CONTROL:
#   By default, only audio detection runs (lightweight, critical for incidents).
#   MP3 transcription (CPU-intensive Whisper) is OPT-IN PER HOST via the
#   ENABLE_TRANSCRIPTION env var — do NOT flip ExecStart here, that would turn
#   Whisper on for every capture node in the fleet (these are Pis).
#
#   Enable on one host with a systemd drop-in:
#     sudo systemctl edit vpt-transcript.service
#       [Service]
#       Environment=ENABLE_TRANSCRIPTION=true
#     sudo systemctl restart vpt-transcript.service
#
#   Equivalent one-off: transcript_accumulator.py --transcript true

[Unit]
Description=VirtualPyTest Transcript Accumulator - Audio Detection & Transcription
After=network.target
Wants=network.target

[Service]
Type=simple
User=vpt_user
Group=vpt_user
WorkingDirectory=%PROJECT_ROOT%
Environment=PYTHONPATH=%PROJECT_ROOT%/shared/lib:%PROJECT_ROOT%/backend_host/src
Environment=PATH=%PROJECT_ROOT%/venv/bin:/usr/bin:/usr/local/bin
Environment=TRANSCRIPTION_WORKERS=2
Environment=MAX_INFLIGHT_PER_DEVICE=1
# Audio detection only by default; override per host with a drop-in (see header).
Environment=ENABLE_TRANSCRIPTION=false
ExecStart=%PROJECT_ROOT%/venv/bin/python backend_host/scripts/transcript_accumulator.py --workers 2 --max-inflight-per-device 1
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
