# NOTE: This is a template file for reference only.
# The actual service file is generated by setup/local/linux/backend_host/install_host.sh
# with correct dynamic paths for your system.
# Renamed from: subtitle-stream.service → subtitle.service (aligned with macOS)

[Unit]
Description=VirtualPyTest Subtitle Accumulator (24h circular subtitle transcription)
After=network.target
Wants=network.target

[Service]
Type=simple
User=vpt_user
Group=vpt_user
WorkingDirectory=%PROJECT_ROOT%/backend_host/scripts
Environment=PYTHONPATH=%PROJECT_ROOT%/shared/lib:%PROJECT_ROOT%/backend_host/src
Environment=PATH=%PROJECT_ROOT%/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/bin/sleep 10
ExecStart=%PROJECT_ROOT%/venv/bin/python %PROJECT_ROOT%/backend_host/scripts/subtitle_monitor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
