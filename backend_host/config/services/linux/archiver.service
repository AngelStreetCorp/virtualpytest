# NOTE: This is a template file for reference only.
# The actual service file is generated by setup/local/linux/backend_host/install_host.sh
# with correct dynamic paths for your system.
# Renamed from: hot_cold_archiver.service → archiver.service (aligned with macOS)
#
# CAPTURE ARCHIVING (for the AVQ frame-by-frame inspector):
#   By default full-res stills are HOT-only (deleted after ~60s).
#   To keep 24h of full-res stills (~2.1 GB/device at 1 fps, ~24KB/frame), add:
#     --keep-captures true            (optionally  --keep-captures-fps 1)
#   Or set ARCHIVE_CAPTURES=true in the host .env (read by install_host.sh below).
#
#   Default (no archiving): ExecStart=.../hot_cold_archiver.py
#   With archiving:         ExecStart=.../hot_cold_archiver.py --keep-captures true

[Unit]
Description=VirtualPyTest Hot/Cold Archiver Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=vpt_user
Group=vpt_user
WorkingDirectory=/opt/virtualpytest
Environment=PYTHONPATH=%PROJECT_ROOT%/shared/lib:%PROJECT_ROOT%/backend_host/src
Environment=PATH=%PROJECT_ROOT%/venv/bin:/usr/bin:/usr/local/bin
ExecStart=/opt/virtualpytest/venv/bin/python backend_host/scripts/hot_cold_archiver.py
# To keep 24h full-res stills, use instead:
# ExecStart=/opt/virtualpytest/venv/bin/python backend_host/scripts/hot_cold_archiver.py --keep-captures true --keep-captures-fps 1
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
