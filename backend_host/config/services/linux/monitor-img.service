[Unit]
Description=VirtualPyTest Capture Monitor Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=vpt_user
Group=vpt_user
WorkingDirectory=%PROJECT_ROOT%/backend_host/scripts
# Load the project .env through systemd as well as python-dotenv. load_dotenv() runs with
# override=False, so these values win, and `systemctl show -p Environment vpt-monitor-img`
# shows what the service actually holds. Note this still only reads the file at start:
# a credential change needs a restart on every host (BUG-0109). Leading '-' = tolerate a
# missing file rather than refusing to start.
EnvironmentFile=-%PROJECT_ROOT%/.env
Environment=PYTHONPATH=%PROJECT_ROOT%/shared/lib:%PROJECT_ROOT%/backend_host/src
Environment=PATH=%PROJECT_ROOT%/venv/bin:/usr/bin:/usr/local/bin
# glibc gives each thread its own malloc arena and keeps the freed memory: on vpt-pi1 the
# monitor held 101 MB in 11 arenas, vpt-kpi 198 MB in 26 (TASK-83). Two arenas are enough
# for Python (the GIL serialises most allocation).
Environment=MALLOC_ARENA_MAX=2
ExecStart=%PROJECT_ROOT%/venv/bin/python %PROJECT_ROOT%/backend_host/scripts/capture_monitor.py
TimeoutStopSec=10
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
# OCR/analysis is best-effort: capture ffmpegs (Nice 0) must win the CPU (tesseract children inherit this)
Nice=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
# Old unit name (TASK-90): kept as an alias so `systemctl restart vpt-monitor` still works.
Alias=vpt-monitor.service
