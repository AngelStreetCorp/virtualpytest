<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.virtualpytest.websockify</string>
    <key>ProgramArguments</key>
    <array>
        <string>@PYTHON_EXE@</string>
        <string>-m</string>
        <string>websockify</string>
        <string>--web</string>
        <string>@NOVNC_DIR@</string>
        <string>--cert=@WEBSOCKIFY_CERT@</string>
        <string>0.0.0.0:6080</string>
        <string>localhost:5900</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@PROJECT_ROOT@</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>UserName</key>
    <string>vpt_user</string>
    <key>StandardOutPath</key>
    <string>@LOGS_PATH@/websockify.log</string>
    <key>StandardErrorPath</key>
    <string>@LOGS_PATH@/websockify_error.log</string>
</dict>
</plist>