<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.virtualpytest.ramdisk</string>
    <key>ProgramArguments</key>
    <array>
        <string>@RAMDISK_SCRIPT@</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@SCRIPTS_PATH@</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <!-- Run at boot, once -->
    <key>RunAtLoad</key>
    <true/>
    <!-- Don't restart - this is a one-shot setup script -->
    <key>KeepAlive</key>
    <false/>
    <!-- Must run as root for hdiutil and mounting -->
    <key>UserName</key>
    <string>root</string>
    <key>StandardOutPath</key>
    <string>@LOGS_PATH@/ramdisk.log</string>
    <key>StandardErrorPath</key>
    <string>@LOGS_PATH@/ramdisk_error.log</string>
</dict>
</plist>
