# VirtualPyTest Backend Host Environment Configuration
# Copy this file to .env: cp .env.example .env
# Used by: backend_host (hardware/device specific)

# =====================================================
# HOST IDENTIFICATION
# =====================================================
HOST_NAME=MyHost
HOST_PORT=6109
HOST_URL=http://localhost
HOST_API_URL=http://localhost:6109
# Interface the host API listens on. 0.0.0.0 = every interface (the UI reaches the host at
# HOST_URL from other machines); unset = the address in HOST_API_URL only.
HOST_BIND_IP=0.0.0.0
SERVER_URL=http://localhost:5109
API_KEY=CHANGE_ME                                        # identical to the server's API_KEY

# =====================================================
# DATABASE + STORAGE — hosts write results and files directly. Same values as the
# server's .env (a host on the server machine also reads the project-level .env).
# =====================================================
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=CHANGE_ME                        # must match the server's; write_env.sh copies it
MINIO_BUCKET=virtualpytest
MINIO_PUBLIC_URL=http://localhost:9000
# or CLOUDFLARE_R2_ENDPOINT / _ACCESS_KEY_ID / _SECRET_ACCESS_KEY / _BUCKET / _PUBLIC_URL

# =====================================================
# HOST TYPE (optional — defaults to host_vnc for full hosts)
# =====================================================
# Set this for runner hosts (lightweight, no stream/VNC services):
#   runner_host           — web + API runner (Playwright, HTTP)
#   runner_android_mobile — ADB runner for Android phone
#   runner_android_tablet — ADB runner for Android tablet
#   runner_android_tv     — ADB runner for Android TV
# Leave unset or set to host_vnc for a full host with all services.
# HOST_TYPE=runner_host
# =====================================================
# HOST VIDEO CONFIGURATION (VNC/Desktop Capture)
# =====================================================
# Enable HOST capture by setting these variables (VNC display capture)
# To disable: comment out or prefix with 'x' (e.g., xHOST_VIDEO_SOURCE=:1)
HOST_VIDEO_SOURCE=:1                                    # VNC display number (e.g., :1 for display 1)
# Audio device. Default 'null' = no audio capture (heatmap shows Audio "N/A").
# Set 'default' to capture the VNC desktop's PulseAudio (auto_null.monitor) into the
# HLS segments — pulseaudio + the null-sink are already provisioned by install_host.sh,
# so no extra setup is needed; just set this and restart vpt-stream.service.
# Only enable on hosts with a real/continuous audio source — a silent desktop reads as
# Audio "No" (red), not "N/A". For HDMI capture devices use an ALSA name (e.g. plughw:1,0).
HOST_VIDEO_AUDIO=null
HOST_VIDEO_CAPTURE_PATH=/var/www/html/stream/capture    # Capture output directory
# VNC stream/input frame rate. MUST be >= 5: captures are pinned to 5 fps for freeze
# detection, and a lower input upsamples them (duplicate frames → false freeze).
# 10 = smoother stream (captures stay 5 fps, decoupled). See OPTIMIZATION.md §2f.
HOST_VIDEO_FPS=10
HOST_VNC_STREAM_PATH=http://localhost/host/vnc/vnc_lite.html
# 24h review buffer: cold 10-min video chunks behind "Last 24h" and test report videos.
# false = no video to cold storage (SD-card hosts that cannot take the writes); Last 24h is
# disabled and report videos only cover the ~60 s hot window. Restart vpt-archiver + vpt-host.
ARCHIVE_VIDEO=true
# WebRTC (WEB button) for v4l2 captures: an extra Opus audio encode + RTSP copy to
# MediaMTX in every capture ffmpeg. false = HLS only (WEB falls back to HLS); also
# stop vpt-mediamtx. Restart vpt-stream after changing.
WEBRTC_ENABLED=true
# VAAPI modes for the capture ffmpeg (TASK-95; unset = today's behaviour). Restart vpt-stream after changing.
# VAAPI_MODE: auto (GPU decode + encode when a render node exists) | off (software everywhere, same as an
#   empty /tmp/vpt_vaapi_render_node) | decode_only (GPU decode, software scale + libx264) |
#   encode_only (software decode, hwupload + h264_vaapi) | full (frames stay on the GPU, network sources
#   only; falls back to auto with a subtitle burn-in and to software if the GPU cannot decode the source).
# VAAPI_MIN_QUALITY: low (default) | sd | hd | hd_plus - qualities below it use software libx264.
# SW_THREADS: 0 (default) | N - thread limit (-threads, -filter_complex_threads, x264 threads) of the
#   software network-source encode.
# VAAPI_MODE=auto
# VAAPI_MIN_QUALITY=low
# SW_THREADS=0
# FFMPEG_THREADS: unset (default) | positive N - limit decoder, complex filter graph and each
#   video encoder on every source type, including VAAPI. Useful on hosts with many streams;
#   unlike HOST_PROFILE=lite, this keeps WebRTC enabled. Overrides SW_THREADS when set.
#   Restart vpt-stream after changing.
# FFMPEG_THREADS=1
# Host profile. lite = one capture device on a 1 GB board: install_host.sh installs only
# vpt-host/stream/monitor/archiver (no desktop, VNC, transcript, KPI, WebRTC, AVQ, companion)
# and 512 MB zram; the capture ffmpeg runs single-threaded and HLS only. Set it BEFORE running
# install_host.sh. Unset = full host. See docs/tasks/TASK-83-lite-host-1gb.md.
# HOST_PROFILE=lite

# =====================================================
# TRANSCRIPT AUTO-CORRECTION (needs ENABLE_TRANSCRIPTION=true on vpt-monitor-audio)
# =====================================================
# LLM spelling/grammar pass over the live transcript: raw lines show at once, then
# are rewritten in place (tinted in the UI). One AI call per transcribed minute per
# device; pick the model in Settings > AI routing > "Transcript correction".
# Restart vpt-monitor-audio after changing.
TRANSCRIPT_AUTOCORRECT=false
HOST_VNC_PASSWORD=CHANGE_ME                       # generated per install by install_host.sh
HOST_VIDEO_STREAM_PATH=/host/stream/capture
HOST_WEB_BROWSER_PATH=/usr/bin/chromium
# By default, the Playwright browser is closed automatically after every web
# test script (facebook_check, youtube_video_check, etc.) finishes. Set this
# to keep it running between scripts (e.g. for debugging, or a multi-script
# sequence that wants to reuse a warm browser).
# VPT_KEEP_BROWSER_OPEN=true
# An async (MCP/REST-polled) testcase reports "completed" once its browser is closed and its
# verdict is in script_results; the report tail (video, mosaic, uploads, HTML report, final
# DB write) then runs in the background and fills the report paths a few seconds later.
# pass (default) = passing runs only, a failed run still waits for its report; all = failed
# runs too; off = every run waits for its report, as before. Read at each run.
# VPT_TESTCASE_BACKGROUND_REPORT=pass
# Seconds a position whose verifications just passed is trusted before the next hop without
# checking it again (the "target is one step away" probe). Testcase action blocks and ad-hoc
# device commands end the trust early. 0 = always check. Restart vpt-host after changing it.
# VPT_POSITION_TRUST_SECONDS=10

# =====================================================
# DEVICE CONFIGURATION
# =====================================================
# Configure up to 30 devices (DEVICE1 through DEVICE30)
# Required FFmpeg variables per device:
#   DEVICE*_VIDEO            - Video source. One of:
#                                * /dev/videoX       — HDMI / USB grabber (v4l2 source)
#                                * *.png / *.jpg     — imagefile source (Android emulator
#                                                     screencap, see "Device 8" below)
#                                * udp:// / rtsp://  — network feed (Tello, IP camera)
#   DEVICE*_ADB_SERIAL       - Android over USB: adb serial (see `adb devices`).
#                              Two capture modes share this key:
#                                (a) scrcpy (default): when DEVICEn_VIDEO is unset, run_ffmpeg
#                                    drives the device with scrcpy and reads its pipe.
#                                (b) screencap (this template, see "Device 8"): when
#                                    DEVICEn_VIDEO points to a PNG path, the
#                                    vpt-emulator-fifo@device<n>.service loop pumps
#                                    `adb -s $serial screencap -p` into that PNG every
#                                    0.2 s and run_ffmpeg reads it as an imagefile.
#                                    Multiple handsets on one host = one service instance
#                                    per slot, each writing its own PNG.
#   DEVICE*_VIDEO_AUDIO      - Audio device (plughw:X,0 or null). The Host & Devices
#                              form auto-fills this from the host's UVC+UAC USB-topology
#                              walk — the operator no longer needs to SSH in and run
#                              `arecord -l` to look up the value. Leave this blank or
#                              set it to `null` to start; the next save through the form
#                              writes the detected value back here. See STREAM.md §5
#                              and the "Detected Grabbers" panel in the UI.
#   DEVICE*_VIDEO_CAPTURE_PATH - Capture output directory
#   DEVICE*_VIDEO_FPS        - Frame rate (10 FPS recommended for hardware)
#   DEVICE*_MODEL            - Also selects the AV implementation (hdmi_stream / camera_stream /
#                              vnc_stream) via shared/src/lib/config/device_capabilities.py.
#                              There is no separate "capture type" variable — see Device 5
#                              below for a USB camera.
#
# To disable a device: prefix variable name with 'x' or comment with '#'
# Example: xDEVICE2_VIDEO=/dev/video2

# Device 1 Example
xDEVICE1_NAME=AppleTv
xDEVICE1_MODEL=apple_tv
xDEVICE1_IP=192.168.1.27                                 # ADB over TCP (LAN)
xDEVICE1_PORT=5555
# xDEVICE1_ADB_SERIAL=R58M12ABCDE                        # ADB over USB (takes priority over IP/PORT)
xDEVICE1_VIDEO=/dev/video0                               # Video device
xDEVICE1_VIDEO_AUDIO=plughw:2,0                          # Audio device (run 'arecord -l' to find)
xDEVICE1_VIDEO_CAPTURE_PATH=/var/www/html/stream/capture1
xDEVICE1_VIDEO_FPS=10                                    # Frame rate
xDEVICE1_VIDEO_STREAM_PATH=/host/stream/capture1
# IR remote — three transports, pick ONE per device (all keyed off IR_TYPE for the
# frontend layout + keymap; IR_SERIAL vs IR_PATH vs IR_IP selects the transport).
#
# (a) Local lirc / ir-ctl transmitter (Raspberry Pi: the kernel publishes /dev/lirc*):
xDEVICE1_IR_PATH=/dev/lirc0
xDEVICE1_IR_TYPE=samsung
#
# (c) USB IR Toy / Irdroid (04d8:fd08) over its CDC serial port — for NON-Pi hosts
#     (x86 miniserver, Minisforum). The stock Debian kernel builds no CONFIG_IR_TOY,
#     so the kernel never claims that dongle for IR and no /dev/lirc* can exist;
#     cdc_acm takes it as /dev/ttyACM*. Use the /dev/irtoy udev symlink, never a raw
#     ttyACM number (it changes on replug). ONE physical dongle = ONE controller:
#     give IR_SERIAL to a single device, or the controllers fight over the port.
# xDEVICE1_IR_SERIAL=/dev/irtoy
# xDEVICE1_IR_TYPE=stb
#
# (b) Networked IRTrans box (UDP). One box is shared across STBs; each STB is on a
#     different IR-output LED (1-16) = its "port". Keymap: remote/irtrans_conf/<IR_TYPE>.json
# xDEVICE1_IR_TYPE=stb                  # layout (frontend) + keymap (irtrans_conf/stb.json)
# xDEVICE1_IR_IP=<irtrans-box-ip>       # IRTrans box IP → selects the IRTrans transport
# xDEVICE1_IR_PORT=21000                # optional, default 21000
# xDEVICE1_IR_LED=1                     # IR output LED 1-16 (this STB's port)
# xDEVICE1_IR_REMOTE=STB_remote    # remote name registered in the IRTrans box

# Per-device defaults for navigation scripts (optional).
# When a script is launched WITHOUT --userinterface / --variant, the script
# executor falls back to these; the Run Tests UI also preselects them.
# Precedence: explicit CLI arg > these .env defaults > script's own default.
# DEVICE1_VARIANT is only applied while the effective userinterface is
# DEVICE1_USERINTERFACE (a different UI resets the variant to base).
xDEVICE1_USERINTERFACE=example_tv
xDEVICE1_VARIANT=example-v2-en

# Localize: read a settled screen that moves (TASK-159 step 6; optional, OFF by default, per device).
# 1 = a splash or TV guide whose picture stays the same for 3 s, but with a moving part (words, an ad box), is read by the
# matcher and the screen registry every 5 s instead of being taken for live video. Restart vpt-monitor-img to apply.
# See docs/agent/devices/MONITOR_PROFILES.md section 1b.
# DEVICE1_LOCALIZE_SETTLED=1

# Live-TV companion (features/companion, TASK-05; EXPERIMENTAL, off by default): the
# vpt-companion service identifies what is on screen (screen type, category,
# programme), looks up facts on the web and tracks scores / time left. Costs
# vision calls: identify every 60 s (per category, see below) plus a
# score-bug read every 10 s while a match is on. Needs the host switch too:
# ENABLE_COMPANION=true via a systemd drop-in on vpt-companion.service (the unit
# ships false, like ENABLE_TRANSCRIPTION). Ignored when the feature is disabled
# (DISABLED_FEATURES=companion).
# xDEVICE1_COMPANION=true
# COMPANION_INTERVAL_S=60        # identify interval when the programme's profile sets none (profiles: identify_interval_s)
# COMPANION_CALL_TIMEOUT_S=30    # per AI call; past it the model counts as busy and the companion backs off 30s..5min
# COMPANION_SCORE_INTERVAL_S=10   # score-bug reads; raise both on a slow local model (e.g. 60 / 30)
# xDEVICE1_COMPANION_FACTCHECK=true   # debates: check each factual claim with a web search (paid, sourced)
# COMPANION_FACTCHECK_PER_HOUR=6       # fact checks per device per hour
# COMPANION_METER_PER_HOUR=900         # TASK-45: Jev calls per device per hour for the live sentence meter
# COMPANION_FACTCHECK_MIN_CLAIM=0.7    # TASK-45: minimum P(factual_claim) to send a sentence to the web check

# BLE remote (mutually exclusive with IR — pick one per device).
# Wraps the bluetooth/ daemon stack via BluetoothRemoteController. The
# scripts (start.sh, resume.sh, hid_remote.py, agent.py, ble_conf/) are
# tracked in git at backend_host/src/controllers/remote/bluetooth/ and
# deployed to /opt/virtualpytest/backend_host/src/controllers/remote/
# bluetooth/ via update_core.sh — the controller computes the path from
# os.path.dirname(__file__), so there is no SCRIPTS_DIR env var.
# Host setup (one-time): install /etc/sudoers.d/ble-remote and enable
# ble-remote.service. See bluetooth.md § 1.6 for the full integration story.
xDEVICE1_BLE_TYPE=arris                                  # Required: profile under bluetooth/ble_conf/
xDEVICE1_BLE_ADAPTER_HCI=hci0                            # Optional, default hci0
# Spoofed remote address the STB pairs with. MUST be unique across every robot
# in radio range of each other (two robots on the same address steal each
# other's STB). Optional: unset = keep the adapter's current address, or
# 20:21:41:00:1F:1<hci index> for a new adapter (hci1 -> 1F:11, hci2 -> 1F:12).
# Applied on the next Start Pairing (re-pair needed to change it).
# xDEVICE1_BLE_MAC=20:21:41:00:1F:11

# Power control — pick ONE transport per device:
# (a) Tapo smart plug (POWER_NAME must contain 'tapo'):
# xDEVICE1_POWER_NAME=tapo_livingroom
# xDEVICE1_POWER_IP=192.168.1.50
# xDEVICE1_POWER_EMAIL=you@example.com
# xDEVICE1_POWER_PWD=secret
# (b) Custom client REST API. POWER_NAME is the API device name; URL+KEY select this transport:
# xDEVICE1_POWER_NAME=stb01
# xDEVICE1_POWER_API_URL=https://<power-api-host>/api/v1/devices
# xDEVICE1_POWER_API_KEY=<your-api-key>
# (c) Wake-on-LAN PC (e.g. a Windows box). POWER_MAC selects this transport. On = magic packet
#     (this host must be on the PC's LAN), off/reboot = `ssh USER@IP shutdown /s|/r` with this
#     host's SSH key, status = TCP probe of the SSH port. PC prep: docs/agent/devices/WAKE_ON_LAN.md
# xDEVICE1_POWER_MAC=AA:BB:CC:DD:EE:FF
# xDEVICE1_POWER_IP=192.168.1.70
# xDEVICE1_POWER_SSH_USER=pcuser
# xDEVICE1_POWER_SSH_PORT=22
# xDEVICE1_POWER_BROADCAST=192.168.1.255

# FX voice modems (TASK-71, docs/agent/devices/FIXNET_FX_MODEMS.md): a mini PC with four USB voice modems,
# each wired to one gateway FXS port, is four devices. One block per modem; the number is the CLI of the line the
# modem DIALS (a property of the pairing, not of the dongle). /dev/fx1..fx4 are the stable udev names from
# setup/local/linux/backend_host/install_fixnet_prereqs.sh (never /dev/ttyACM*, which changes across reboots).
# Modems that are not cabled stay out of the list. Disabled here with the 'x' prefix, like the examples around it.
# No MONITOR_PROFILE line is needed: MODEL_PROFILES maps fx_dongle to the `fixnet` profile (TASK-151), which runs no
# image / audio-level / subtitle monitor and no archiver (a telephone has no picture) and keeps the KPI scan and the
# per-minute A/V quality score. DEVICE<n>_MONITOR_PROFILE overrides it if you want something else.
xDEVICE1_NAME=FX line 1
xDEVICE1_MODEL=fx_dongle
xDEVICE1_FX_PORT=/dev/fx1
xDEVICE1_FX_NUMBER=<CLI the line 1 modem dials>
xDEVICE2_NAME=FX line 2
xDEVICE2_MODEL=fx_dongle
xDEVICE2_FX_PORT=/dev/fx2
xDEVICE2_FX_NUMBER=<CLI the line 2 modem dials>
xDEVICE3_NAME=FX line 3
xDEVICE3_MODEL=fx_dongle
xDEVICE3_FX_PORT=/dev/fx3
xDEVICE3_FX_NUMBER=<CLI the line 3 modem dials>
xDEVICE4_NAME=FX line 4
xDEVICE4_MODEL=fx_dongle
xDEVICE4_FX_PORT=/dev/fx4
xDEVICE4_FX_NUMBER=<CLI the line 4 modem dials>
# Used by test_scripts/gw/fixnet_call.py (restart vpt-host after changing: a host reads its .env at start):
# FIXNET_NUMBER=<CLI of the called line>   # default for --number (the line the call goes TO)
# FIXNET_GCI=A6                            # modem country code, T.35 (A6 = Switzerland; the modem boots on the US profile B5)

# Device 2 Example (disabled with 'x' prefix)
xDEVICE2_NAME=Nokia
xDEVICE2_MODEL=android_tv
xDEVICE2_IP=192.168.1.27
xDEVICE2_PORT=5555
xDEVICE2_VIDEO=/dev/video2
xDEVICE2_VIDEO_AUDIO=plughw:1,0
xDEVICE2_VIDEO_CAPTURE_PATH=/var/www/html/stream/capture2
xDEVICE2_VIDEO_FPS=10
xDEVICE2_VIDEO_STREAM_PATH=/host/stream/capture2

# Device 3 Example: Phone slot (mobile app feature, disabled with 'x' prefix)
# A paired phone streams its screen to this slot and is driven like any other device.
# See docs/technical/MOBILE_APP.md for the pairing flow.
xDEVICE3_NAME=Phone slot 1
xDEVICE3_MODEL=phone_agent
xDEVICE3_VIDEO=/var/www/html/stream/phone_frames/device3/latest.jpg    # .jpg -> run_ffmpeg "imagefile"
xDEVICE3_VIDEO_CAPTURE_PATH=/var/www/html/stream/capture3
xDEVICE3_VIDEO_STREAM_PATH=/host/stream/capture3
xDEVICE3_VIDEO_FPS=3
# Optional, apply to every phone slot on this host (not per-device):
# PHONE_AGENT_FPS=3                 # frames/s requested from the phone (default 3)
# PHONE_AGENT_MAX_SIDE=1280         # phone scales frames so the long side <= this (default 1280)
# PHONE_AGENT_STATE_FILE=/var/www/html/stream/phone_frames/state.json  # pairing/session state

# Device 4 Example: cloud device farm slot (device-farm feature, disabled with 'x' prefix)
# The device lives in Sauce Labs / BrowserStack / LambdaTest, not on this host: there is no
# capture card and no UDID. A WebDriver session is opened on the first command and released
# after use (it is billed per minute), and screenshots are pumped into the .jpg below so the
# normal ffmpeg imagefile grabber makes the HLS stream and captures.
# See features/device-farm/README.md and docs/tasks/TASK-20-device-farm-integration.md.
xDEVICE4_NAME=Pixel 8 (Sauce)
xDEVICE4_MODEL=cloud_android_mobile            # or cloud_ios_mobile
xDEVICE4_APPIUM_PLATFORM_NAME=Android          # Android | iOS
xDEVICE4_VIDEO=/var/www/html/stream/farm_frames/device4/latest.jpg   # .jpg -> run_ffmpeg "imagefile"
xDEVICE4_VIDEO_CAPTURE_PATH=/var/www/html/stream/capture4
xDEVICE4_VIDEO_STREAM_PATH=/host/stream/capture4
xDEVICE4_VIDEO_FPS=1
# Farm account and device request (the farm allocates from a pool, so the device is a request):
xDEVICE4_FARM_PROVIDER=saucelabs               # saucelabs | browserstack | lambdatest
xDEVICE4_FARM_USER=<farm-username>
xDEVICE4_FARM_KEY=<farm-access-key>            # secret: never goes in a URL, masked in logs
xDEVICE4_FARM_REGION=us-west-1                 # provider datacenter
xDEVICE4_FARM_DEVICE=Samsung Galaxy S23 FE     # must EXIST in this account's pool, or the
                                               # session fails as a bare "Internal Server Error".
                                               # List it: GET /v1/rdc/devices/available, then
                                               # GET /v1/rdc/devices/<id> for name + osVersion.
                                               # A trial is not emulator-only: it can allocate the
                                               # real devices Sauce marks `_free`.
xDEVICE4_FARM_OS_VERSION=16
# Required — Sauce refuses a session with "No browserName or app specified":
xDEVICE4_FARM_APP=storage:<file-id>            # build under test (storage: / bs:// / lt://)
# Optional:
# xDEVICE4_FARM_BUILD=nightly-2026-09-17       # groups sessions in the farm UI
# xDEVICE4_FARM_IDLE_TIMEOUT=180               # seconds the farm keeps an idle session
# xDEVICE4_FARM_MAX_DURATION=1800              # seconds before the farm kills the session
# xDEVICE4_FARM_SCREENSHOT_FPS=1               # every frame is a billed round-trip (max 5)
# Host-wide (not per-device): cap on concurrent farm sessions. Keep it at or below the
# account's parallel-session limit — exceeding it fails other people's runs too.
# FARM_MAX_SESSIONS=2

# Device 5 Example: USB camera / webcam (disabled with 'x' prefix)
# Use a camera when there is no HDMI output to capture — the camera is pointed at the
# device's own screen (a TV panel, a kiosk, a phone in a rig). Capture is otherwise
# identical to HDMI: a v4l2 /dev/videoX source into the same ffmpeg -> HLS pipeline.
#
# IMPORTANT — the camera AV controller is selected by MODEL, not by a separate flag.
# Use MODEL=camera (see `shared/src/lib/config/device_capabilities.py`). An unknown
# model is NOT an error: get_device_capabilities returns av=None, so the device comes
# up silently with no AV controller at all. If a camera shows no stream, check this first.
# Capabilities for `camera`: av=camera_stream, remote=ir_remote/bluetooth_remote/
# irtrans_remote, power=tapo/api_power/wol.
# `tizen` also maps to camera_stream, but means an actual Samsung Tizen TV — do not use
# it as a generic stand-in for a camera.
#
# Find the camera:  v4l2-ctl --list-devices
#                   (a UVC webcam usually claims two /dev/videoX nodes; the lower number
#                    is normally the capture node — confirm with `v4l2-ctl -d /dev/videoX --all`)
# Find its mic:     arecord -l        (use null below if the camera has no microphone)
xDEVICE5_NAME=TV Camera
xDEVICE5_MODEL=camera                                    # selects camera_stream — see note above
xDEVICE5_VIDEO=/dev/video0                               # v4l2 capture node
xDEVICE5_VIDEO_AUDIO=null                                # or plughw:X,0 if the camera has a mic
xDEVICE5_VIDEO_CAPTURE_PATH=/var/www/html/stream/camera  # camera_stream controller default
xDEVICE5_VIDEO_STREAM_PATH=/host/camera/stream           # camera_stream controller default
xDEVICE5_VIDEO_FPS=10
# Optional remote for the camera-captured device (IR shown; BLE and IRTrans also supported):
# xDEVICE5_IR_PATH=/dev/lirc0
# xDEVICE5_IR_TYPE=samsung

# --- Tello drones (device model `tello`, TASK-32) ---------------------------------------
# One entry per drone. A plain Tello is its own Wi-Fi access point (192.168.10.1), so two on
# one host collide on both the IP and the ports. Pick ONE of the two schemes below.
#
# A) Namespaces (needs a driver that supports `iw phy set netns`): scripts/drone/tello_netns.sh
#    puts drone n at 10.200.<n>.2 and moves its state/video to host ports 8890+n / 11110+n.
# B) Source-based policy routing (any driver, including the AIC8800DC, which cannot do A):
#    scripts/drone/tello_prio.sh keeps both radios in the host namespace and separates them by
#    source address. Set TELLO_LOCAL_IP per drone and use the SAME address in DEVICE_VIDEO so
#    every socket to that drone leaves through its own radio. Both APs still answer 192.168.10.1,
#    and both drones still use the stock 8890 / 11111.
#
# A single drone can use 192.168.10.1 with the default ports and no TELLO_LOCAL_IP at all.
# DEVICE{i}_VIDEO is where the H.264 stream is received (the drone pushes it to this host after
# `streamon`); vpt-stream ingests it like any live feed.
#
# (A) two drones, namespaces
# xDEVICE6_NAME=Tello 1
# xDEVICE6_MODEL=tello
# xDEVICE6_TELLO_IP=10.200.1.2
# xDEVICE6_TELLO_STATE_PORT=8890
# xDEVICE6_TELLO_VIDEO_PORT=11111
# xDEVICE6_VIDEO=udp://0.0.0.0:11111
# xDEVICE6_VIDEO_CAPTURE_PATH=/var/www/html/stream/capture6
# xDEVICE6_VIDEO_FPS=10
# xDEVICE7_NAME=Tello 2
# xDEVICE7_MODEL=tello
# xDEVICE7_TELLO_IP=10.200.2.2
# xDEVICE7_TELLO_STATE_PORT=8891
# xDEVICE7_TELLO_VIDEO_PORT=11112
# xDEVICE7_VIDEO=udp://0.0.0.0:11112
# xDEVICE7_VIDEO_CAPTURE_PATH=/var/www/html/stream/capture7
# xDEVICE7_VIDEO_FPS=10

# --- A drone that can be in the lab OR in a field (TASK-167 / TASK-173) ---------------------
# A Tello sits on ONE Wi-Fi network at a time. The host keeps both routes to it: the lab's own
# radio (the dongle below) and a phone's hotspot, relayed over the mobile app's Socket.IO link.
# The sidecar (features/mobile-app/backend_host/drone_bridge.py) presents the drone as a local
# UDP peer on 127.0.0.1, so the controller, the safety guard, the telemetry and the video
# pipeline are unchanged - only the address is local and the bridge holds the radio.
#
# The phone path only (a drone that is always in a field):
#   DEVICE8_TELLO_BRIDGE=phone               # this drone can be served through a phone
#   DEVICE8_TELLO_BRIDGE_PHONE=device2       # the phone_agent slot that carries it
#   DEVICE8_TELLO_BRIDGE_DRONE=droneA        # the label the owner gave it in the phone app
#   DEVICE8_TELLO_IP=127.0.0.1               # the sidecar answers here
#   DEVICE8_TELLO_CMD_PORT=28001             # the sidecar's command port
#   DEVICE8_TELLO_STATE_PORT=28901           # the sidecar injects the drone's state here
#   DEVICE8_TELLO_LOCAL_CMD_PORT=8881        # the client's own local port (per drone)
#   DEVICE8_VIDEO=udp://127.0.0.1:29001      # the sidecar injects the drone's RTP here
#
# The hybrid (the drone is in the lab today and in the garden tomorrow):
#   DEVICE8_TELLO_LINK=auto                  # auto = the lab first, the phone as the fallback
#   DEVICE8_TELLO_DIRECT_IP=192.168.10.1     # the drone's address on the lab network
#   DEVICE8_TELLO_DIRECT_LOCAL_IP=192.168.10.2   # the dongle's address (the source the drone sees)
#   DEVICE8_TELLO_DIRECT_LOCAL_CMD_PORT=8883     # the sidecar's own SDK socket towards the drone
#   DEVICE8_TELLO_DIRECT_CMD_PORT=8889      # the drone's SDK port
#   DEVICE8_TELLO_DIRECT_STATE_PORT=8890    # where the drone pushes its state on the lab network
#   DEVICE8_TELLO_DIRECT_VIDEO_PORT=11111    # where the drone pushes its RTP on the lab network
#
# The hotspot's SSID and password never go here: they are set once in the Tello app next to the
# drone, and they live in the phone's Android hotspot settings.
#
# (B) two drones, policy routing - one USB dongle each, e.g. drone 1 on wlan1, drone 2 on wlan2:
#   sudo scripts/drone/tello_prio.sh up 1 wlan1 TELLO-XXXXXX
#   sudo scripts/drone/tello_prio.sh up 2 wlan2 TELLO-YYYYYY
# xDEVICE6_NAME=Tello 1
# xDEVICE6_MODEL=tello
# xDEVICE6_TELLO_IP=192.168.10.1
# xDEVICE6_TELLO_LOCAL_IP=192.168.10.2      # this radio's address, must match `ip rule from`
# xDEVICE6_TELLO_STATE_PORT=8890
# xDEVICE6_TELLO_VIDEO_PORT=11111
# xDEVICE6_VIDEO=udp://192.168.10.2:11111   # same address, so ffmpeg binds that radio
# xDEVICE6_VIDEO_CAPTURE_PATH=/var/www/html/stream/capture6
# xDEVICE6_VIDEO_FPS=10
# xDEVICE7_NAME=Tello 2
# xDEVICE7_MODEL=tello
# xDEVICE7_TELLO_IP=192.168.10.1
# xDEVICE7_TELLO_LOCAL_IP=192.168.10.4
# xDEVICE7_TELLO_STATE_PORT=8890            # the stock port; the drones are told apart by source IP
# xDEVICE7_TELLO_VIDEO_PORT=11111
# xDEVICE7_VIDEO=udp://192.168.10.4:11111
# xDEVICE7_VIDEO_CAPTURE_PATH=/var/www/html/stream/capture7
# xDEVICE7_VIDEO_FPS=10

# --- A drone that can be in the lab OR in a field (TASK-167 / TASK-173) ---------------------
# A Tello sits on ONE Wi-Fi network at a time. The host keeps both routes to it: the lab's own
# radio (the dongle below) and a phone's hotspot, relayed over the mobile app's Socket.IO link.
# The sidecar (features/mobile-app/backend_host/drone_bridge.py) presents the drone as a local
# UDP peer on 127.0.0.1, so the controller, the safety guard, the telemetry and the video
# pipeline are unchanged - only the address is local and the bridge holds the radio.
#
# The phone path only (a drone that is always in a field):
#   DEVICE8_TELLO_BRIDGE=phone               # this drone can be served through a phone
#   DEVICE8_TELLO_BRIDGE_PHONE=device2       # the phone_agent slot that carries it
#   DEVICE8_TELLO_BRIDGE_DRONE=droneA        # the label the owner gave it in the phone app
#   DEVICE8_TELLO_IP=127.0.0.1               # the sidecar answers here
#   DEVICE8_TELLO_CMD_PORT=28001             # the sidecar's command port
#   DEVICE8_TELLO_STATE_PORT=28901           # the sidecar injects the drone's state here
#   DEVICE8_TELLO_LOCAL_CMD_PORT=8881        # the client's own local port (per drone)
#   DEVICE8_VIDEO=udp://127.0.0.1:29001      # the sidecar injects the drone's RTP here
#
# The hybrid (the drone is in the lab today and in the garden tomorrow):
#   DEVICE8_TELLO_LINK=auto                  # auto = the lab first, the phone as the fallback
#   DEVICE8_TELLO_DIRECT_IP=192.168.10.1     # the drone's address on the lab network
#   DEVICE8_TELLO_DIRECT_LOCAL_IP=192.168.10.2   # the dongle's address (the source the drone sees)
#   DEVICE8_TELLO_DIRECT_LOCAL_CMD_PORT=8883     # the sidecar's own SDK socket towards the drone
#   DEVICE8_TELLO_DIRECT_CMD_PORT=8889      # the drone's SDK port
#   DEVICE8_TELLO_DIRECT_STATE_PORT=8890    # where the drone pushes its state on the lab network
#   DEVICE8_TELLO_DIRECT_VIDEO_PORT=11111    # where the drone pushes its RTP on the lab network
#
# The hotspot's SSID and password never go here: they are set once in the Tello app next to the
# drone, and they live in the phone's Android hotspot settings.

# --- Real Android handset over `adb screencap` (no HDMI, no scrcpy) -----------------------
# A real phone (or tablet) attached to the host over USB or `adb tcpip`. The same image-file
# pipeline the Android emulator fleet uses — but instead of `emulator-5554` the screencap loop
# targets a real adb serial, so the host needs no AVD, no KVM, and no HDMI grabber. One loop
# instance per device (each writes its own PNG), then run_ffmpeg's imagefile branch produces
# the same HLS stream / captures / thumbnails as any other device. This is the
# "android_mobile via screencap" model — the `phone_agent` model is the same idea but for
# phones paired through the VirtualPyTest mobile app, and `cloud_android_mobile` is the
# device-farm variant; all three share the same imagefile downstream.
#
# Pipeline:
#   adb -s $ADB_SERIAL exec-out screencap -p
#           ↓
#   /var/www/html/stream/emulator_frames/device<n>/latest.png   (loop, 0.2 s; see self-heal in the script)
#           ↓
#   run_ffmpeg.sh (imagefile branch, run_ffmpeg.md §3)        → HLS + captures/ + thumbnails/
#
# Wiring (Linux host): nothing to enable by hand. On every start vpt-stream runs
# setup/local/linux/backend_host/ensure_screencap_loops.sh, which installs the
# vpt-emulator-fifo@ template if needed and starts vpt-emulator-fifo@deviceN for every slot with
# DEVICEn_ADB_SERIAL set and DEVICEn_VIDEO under emulator_frames/deviceN/ (and stops the
# instances of slots removed from .env). So: edit .env, then `sudo systemctl restart vpt-stream`.
# The template reads DEVICEn_ADB_SERIAL and DEVICEn_VIDEO from this .env, so no per-instance
# service file is needed. vpt-stream.service will start ffmpeg once both the capture dir and
# the .png exist; the imagefile branch in run_ffmpeg.sh waits up to 120 s for the first valid
# frame. Audio is null (screencap carries no audio); the device reports "Audio N/A".
#
# macOS host: launch the same loop in a tmux pane instead of systemd. The script is plain
# bash, no Linux-only deps.
#   tmux new-session -d -s screencap-device8 \
#     '/opt/virtualpytest/backend_host/scripts/emulator_screencap.sh "" "" device8'
#
# Example — a Mac with two USB-tethered phones (S7 + Honor):
xDEVICE8_NAME=S7
xDEVICE8_MODEL=android_mobile
xDEVICE8_ADB_SERIAL=ce12160c62740a2801
xDEVICE8_VIDEO=/var/www/html/stream/emulator_frames/device8/latest.png
xDEVICE8_VIDEO_AUDIO=null
xDEVICE8_VIDEO_CAPTURE_PATH=/var/www/html/stream/capture8
xDEVICE8_VIDEO_STREAM_PATH=/host/stream/capture8
xDEVICE8_VIDEO_FPS=10
xDEVICE9_NAME=Honor
xDEVICE9_MODEL=android_mobile
xDEVICE9_ADB_SERIAL=UEUDU16C14012463
xDEVICE9_VIDEO=/var/www/html/stream/emulator_frames/device9/latest.png
xDEVICE9_VIDEO_AUDIO=null
xDEVICE9_VIDEO_CAPTURE_PATH=/var/www/html/stream/capture9
xDEVICE9_VIDEO_STREAM_PATH=/host/stream/capture9
xDEVICE9_VIDEO_FPS=10
# (The x- prefix above means "disabled" — the loop service above un-suppresses them at
# enable time, but the actual /var/www/html/stream/... paths are read straight from the
# variables. Remove the `x` when you're ready to start the slot.)

# =====================================================
# AUDIO DEVICE DETECTION
# =====================================================
# To find your audio devices, run: arecord -l
# Output example:
#   card 2: Device [USB Audio Device], device 0: USB Audio [USB Audio]
#   Use: plughw:2,0 (card 2, device 0)
#
# For devices without audio, use: null

# =====================================================
# ADDITIONAL DEVICE EXAMPLES
# =====================================================
# Add more devices by copying the pattern:
# DEVICE3_NAME=...
# DEVICE3_VIDEO=/dev/video4
# DEVICE3_VIDEO_AUDIO=plughw:3,0
# DEVICE3_VIDEO_CAPTURE_PATH=/var/www/html/stream/capture3
# DEVICE3_VIDEO_FPS=10
# ... (up to DEVICE10)

# =====================================================
# FREEZE ALERT FACTS FOR JEV (TASK-55) — read by vpt-monitor-img (restart it to apply)
# =====================================================
# ALERT_JEV_FACTS_ENABLED=false   # true = write metadata.jev_facts on every new freeze alert (frames + OCR, off the frame path)

# =====================================================
# NOTES
# =====================================================
# 1. This is the SINGLE SOURCE OF TRUTH for capture configuration
# 2. After editing, restart services: sudo systemctl restart stream monitor
# 3. Check logs: tail -f /tmp/ffmpeg_service.log
# 4. See backend_host/scripts/CAPTURE_CONFIG.md for full documentation

# vpt-windows host_vnc audio capture (BUG-0596, 2026-10-17)
# Mirrors vpt-stream's audio muxing on Linux: parallel audio HLS playlist
# for the host desktop loopback. Disabled by default -- leave DEVICE{N}_HOST_VNC_AUDIO_DEVICE
# empty for silent hosts. Capture script and Scheduled Task (vpt-windows-audio) live in
# backend_host/scripts/.
# DEVICE1_HOST_VNC_AUDIO_DEVICE=Mixage_stereo
# DEVICE1_HOST_VNC_AUDIO_STREAM_PATH=/stream/device1_audio
# DEVICE1_HOST_VNC_AUDIO_SEGMENT_SECONDS=2
