# VirtualPyTest Project-Level Environment Configuration
# Copy this file to .env: cp env.example .env
# Used by: backend_server, backend_core, shared
# =====================================================
# SERVER CONFIGURATION
# =====================================================
SERVER_NAME=Awesomation
SERVER_URL=http://192.168.x.103:5109
SERVER_PORT=5109
FLASK_SECRET_KEY=your_flask_secret_key_here
API_KEY=your-api-key
# =====================================================
# DATABASE - SUPABASE
# =====================================================
SUPABASE_URL=http://192.168.x.102:54321
# TASK-17: the same Supabase, but the URL a BROWSER can reach — SUPABASE_URL above is
# LAN-only, so it cannot be handed to the frontend and is not unique either (every node's
# database VM has the same private address). /server/auth/check advertises this value, and
# the frontend groups logins by it: servers sharing one Supabase MUST carry an identical
# value (they then share a single login), a server on its own Supabase gets its own and is
# asked for credentials once. Omit it and this server advertises no identity, so the
# frontend falls back to sending it the primary server's token.
SUPABASE_PUBLIC_URL=https://your-domain.example/supabase
# TASK-10: the server (a trusted process) MUST run on the service_role key, which
# bypasses RLS. The anon key is for the frontend build only. get_supabase_client()
# prefers SERVICE_ROLE; without it the server falls back to anon and logs a warning.
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_DB_URI=postgresql://postgres:postgres@192.168.x.102:54322/postgres
# =====================================================
# STORAGE - MINIO
# =====================================================
MINIO_ENDPOINT=http://192.168.x.101:9000
MINIO_ACCESS_KEY=virtualpytest
MINIO_SECRET_KEY=CHANGE_ME          # from the storage VM's .env
MINIO_BUCKET=virtualpytest
MINIO_CONSOLE_URL=http://192.168.x.101:9001
# =====================================================
# STORAGE - REDIS
# =====================================================
REDIS_URL=redis://:CHANGE_ME@192.168.x.101:6379/0
# =====================================================
# AI
# =====================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
MCP_SECRET_KEY=vpt_mcp_secretxxxxxxxxx

# Grafana Metrics Database (local)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_SECRET_KEY=nqiDccxxxxxxxx
GRAFANA_DOMAIN=www.virtualpytest.com
# =====================================================
# ENVIRONMENT
# =====================================================
ENVIRONMENT=development
DEBUG=1