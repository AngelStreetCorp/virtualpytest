# VirtualPyTest Project-Level Environment Configuration
# Copy this file to .env: cp env.example .env
# Used by: backend_server, backend_core, shared
# =====================================================
# SERVER CONFIGURATION
# =====================================================
SERVER_NAME=Awesomation
SERVER_URL=http://10.10.x.31:5109
SERVER_PORT=5109
FLASK_SECRET_KEY=your_flask_secret_key_here
API_KEY=your-api-key
# =====================================================
# DATABASE - SUPABASE
# =====================================================
SUPABASE_URL=http://10.10.x.41:54321
# TASK-10: the server (a trusted process) MUST run on the service_role key, which
# bypasses RLS. The anon key is for the frontend build only. get_supabase_client()
# prefers SERVICE_ROLE; without it the server falls back to anon and logs a warning.
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_DB_URI=postgresql://postgres:postgres@10.10.x.41:54322/postgres
# =====================================================
# STORAGE - MINIO
# =====================================================
MINIO_ENDPOINT=http://10.10.x.51:9000
MINIO_ACCESS_KEY=virtualpytest
MINIO_SECRET_KEY=admin1234
MINIO_BUCKET=virtualpytest
MINIO_CONSOLE_URL=http://10.10.x.51:9001
# =====================================================
# STORAGE - REDIS
# =====================================================
REDIS_URL=redis://:admin1234@10.10.x.51:6379/0
# =====================================================
# AI
# =====================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
MCP_SECRET_KEY=vpt_mcp_secretxxxxxxxxx

# Grafana Metrics Database (local)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_SECRET_KEY=nqiDccxxxxxxxx
GRAFANA_DOMAIN=www.virtualpytest.com
# =====================================================
# ENVIRONMENT
# =====================================================
ENVIRONMENT=development
DEBUG=1