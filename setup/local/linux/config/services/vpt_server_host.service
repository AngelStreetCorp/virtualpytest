# NOTE: This is a template file for reference only.
# The actual service file is generated by setup scripts
# with correct dynamic paths for your system.

[Unit]
Description=VirtualPyTest Backend Server Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=vpt_user
Group=vpt_user
WorkingDirectory=%PROJECT_ROOT%/backend_server
Environment=PYTHONPATH=%PROJECT_ROOT%/shared/lib:%PROJECT_ROOT%/backend_server/src
Environment=PATH=%PROJECT_ROOT%/venv/bin:/usr/bin:/usr/local/bin
ExecStartPre=/usr/bin/git -C %PROJECT_ROOT% pull
ExecStart=%PROJECT_ROOT%/venv/bin/python src/app.py
Restart=always
RestartSec=10
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vpt-server-host

[Install]
WantedBy=multi-user.target
