# MinIO Service Configuration
# This service file configures MinIO (S3-compatible object storage) for VirtualPyTest
# Deployed to: /etc/systemd/system/minio.service

[Unit]
Description=MinIO
Documentation=https://docs.min.io
Wants=network-online.target
After=network-online.target
AssertFileIsExecutable=/usr/local/bin/minio

[Service]
Type=simple
User=minio-user
Group=minio-user
EnvironmentFile=/etc/default/minio
ExecStartPre=/bin/bash -c "if [ -z \"${MINIO_ROOT_USER}\" ]; then echo \"Variable MINIO_ROOT_USER not set in /etc/default/minio\"; exit 1; fi"
ExecStartPre=/bin/bash -c "if [ -z \"${MINIO_ROOT_PASSWORD}\" ]; then echo \"Variable MINIO_ROOT_PASSWORD not set in /etc/default/minio\"; exit 1; fi"
ExecStart=/usr/local/bin/minio server $MINIO_OPTS $MINIO_DRIVES
Restart=always
RestartSec=5
Environment=MINIO_CACHE_DRIVES=

# Process management
LimitNOFILE=1048576
TimeoutStopSec=30

# Sandboxing (relaxed for MinIO functionality)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ReadWritePaths=/data/minio /etc/minio /usr/local/share/minio
ProtectSystem=full
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
