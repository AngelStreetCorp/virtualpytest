# VirtualPyTest: port-pinned video grabbers + ALSA card names
#
# Source template — copy to /etc/udev/rules.d/70-vpt-persistent.rules on the
# backend_host, customize the KERNELS=="X-Y" tokens to match this host's USB
# topology, then `sudo udevadm control --reload-rules && sudo udevadm trigger`.
#
# Discovery:
#   sudo scripts/detect_grabber.sh
# The USB-PATH column ("3-1", "3-2", …) is what each KERNELS token should be.
#
# Full guide: docs/agent/devices/PERSISTENT_DEVICES.md
#
# Bluetooth note: hciN is *not* renameable by udev (BT controllers aren't
# netdevs). We don't add BT rules here; we rely on USB port enumeration order
# at boot. See PERSISTENT_DEVICES.md "Why Bluetooth is different".
#
# ATTR{index}=="0" filters the UVC capture node from its metadata sibling
# (MS2109 dongles expose both under the same USB port).
# ATTR{id}= (assignment) sets the ALSA card's symbolic name → reachable as
# plughw:<name>,0 regardless of which numeric card index the kernel gave it.

# ---------------------------------------------------------------------------
# Example mapping for host3 (4× MS2109 HDMI grabbers).
# Replace KERNELS tokens with this host's actual ports from detect_grabber.sh.
# ---------------------------------------------------------------------------

# STB 1 — USB port 3-1
SUBSYSTEM=="video4linux", KERNELS=="3-1", ATTR{index}=="0", SYMLINK+="stb1"
SUBSYSTEM=="sound",       KERNELS=="3-1", ATTR{id}="stb1"

# STB 2 — USB port 3-2
SUBSYSTEM=="video4linux", KERNELS=="3-2", ATTR{index}=="0", SYMLINK+="stb2"
SUBSYSTEM=="sound",       KERNELS=="3-2", ATTR{id}="stb2"

# STB 3 — USB port 3-4
SUBSYSTEM=="video4linux", KERNELS=="3-4", ATTR{index}=="0", SYMLINK+="stb3"
SUBSYSTEM=="sound",       KERNELS=="3-4", ATTR{id}="stb3"

# STB 4 — USB port 3-5
SUBSYSTEM=="video4linux", KERNELS=="3-5", ATTR{index}=="0", SYMLINK+="stb4"
SUBSYSTEM=="sound",       KERNELS=="3-5", ATTR{id}="stb4"
