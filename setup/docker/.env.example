# VirtualPyTest Docker stack — configuration.
# `./launch.sh` copies this file to `.env` next to it and replaces every CHANGE_ME with
# a generated value (and PUBLIC_HOST with this machine's LAN address), so a first
# start needs no editing. Edit .env afterwards, then `./launch.sh` again.
# Full variable reference: docs/get-started/configuration.md

# ---------------------------------------------------------------------------
# Reachability — the address browsers and other machines use to reach this box.
# Every published URL (frontend, API, Grafana, Supabase, MinIO) is built from it.
# ---------------------------------------------------------------------------
PUBLIC_HOST=localhost

# ---------------------------------------------------------------------------
# Platform identity and secrets
# ---------------------------------------------------------------------------
SERVER_NAME=vpt-docker
HOST_NAME=docker-host
API_KEY=CHANGE_ME
FLASK_SECRET_KEY=CHANGE_ME
MCP_SECRET_KEY=CHANGE_ME
AUTO_SIGN_ENABLED=false

# ---------------------------------------------------------------------------
# /server/* auth posture. Default = OPEN MODE: no login, every API call accepted.
# Only for a machine on a trusted network. To enforce login:
#   SERVER_OPEN_MODE=false
#   VITE_SUPABASE_URL=http://<PUBLIC_HOST>:54321
#   VITE_SUPABASE_ANON_KEY=<the ANON_KEY below>
#   ./launch.sh --rebuild      # the frontend bakes those two values in at build time
# then create a user in Supabase Studio (http://<PUBLIC_HOST>:54321, Authentication).
# ---------------------------------------------------------------------------
SERVER_OPEN_MODE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase (self-hosted, vendored in setup/docker/supabase/)
# ANON_KEY / SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET — launch.sh derives them.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME
JWT_EXPIRY=3600
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE_ME
PG_META_CRYPTO_KEY=CHANGE_ME
SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322

# ---------------------------------------------------------------------------
# Storage — MinIO runs inside the stack (public-URL mode). To use Cloudflare R2
# instead, set CLOUDFLARE_R2_ENDPOINT / _ACCESS_KEY_ID / _SECRET_ACCESS_KEY /
# _BUCKET / _PUBLIC_URL here; they take precedence over MINIO_*.
# ---------------------------------------------------------------------------
MINIO_ACCESS_KEY=vpt
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=virtualpytest

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# AI features (optional — leave empty to run without them)
# ---------------------------------------------------------------------------
AI_AGENT_PROVIDER=
AI_AGENT_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Host-only mode (./launch.sh --host-only): this machine is a device controller
# for a server that runs elsewhere. Uncomment and fill; the stack values above
# are then unused.
# ---------------------------------------------------------------------------
# SERVER_URL=http://<server-address>:5109
# API_KEY=<the server's API_KEY>
# SUPABASE_URL=http://<server-address>:54321
# SUPABASE_ANON_KEY=<the server's ANON_KEY>
# SUPABASE_SERVICE_ROLE_KEY=<the server's SERVICE_ROLE_KEY>
# MINIO_ENDPOINT=http://<server-address>:9000
# MINIO_PUBLIC_URL=http://<server-address>:9000
