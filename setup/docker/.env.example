# VirtualPyTest Docker stack — configuration.
# `./launch.sh` copies this file to `.env` next to it and replaces every CHANGE_ME with
# a generated value (and PUBLIC_HOST with this machine's LAN address), so a first
# start needs no editing. Edit .env afterwards, then `./launch.sh` again.
# Full variable reference: docs/get-started/configuration.md

# ---------------------------------------------------------------------------
# Reachability — the address browsers and other machines use to reach this box.
# Every published URL (frontend, API, Grafana, Supabase, MinIO) is built from it.
# ---------------------------------------------------------------------------
PUBLIC_HOST=localhost

# Behind an HTTPS tunnel, media (archive, captures) must not be fetched from http://<PUBLIC_HOST>:6109.
# Give the host the nginx-style URL and route that path prefix on the API hostname to :6109
# (cloudflared path rule, Caddy/nginx location, ...). The host then gates it with the login
# session cookie, exactly like a native host behind nginx (BUG-0171).
#   HOST_URL=/host/<HOST_NAME>
# Behind an HTTPS tunnel, publish noVNC on its own hostname (the default
# http://<PUBLIC_HOST>:6080 is blocked as mixed content on an HTTPS dashboard):
#   HOST_VNC_STREAM_PATH=https://vnc.example.com/vnc_lite.html
# Let the dashboard pass HOST_VNC_PASSWORD to noVNC so app users connect without a
# prompt. Opening vnc_lite.html directly still asks. The password appears in the
# iframe URL, and so in the access logs of any proxy in front of noVNC.
#   HOST_VNC_AUTOCONNECT=true

# ---------------------------------------------------------------------------
# Container images for backend_server and backend_host.
#   local            build both from this checkout (default — always matches your code)
#   <release tag>    pull prebuilt images from GHCR, e.g. release-2026.09.15
#                    (skips a ~10 min first build; use the tag you checked out)
# The frontend always builds locally — it bakes PUBLIC_HOST in at build time.
# ---------------------------------------------------------------------------
# `local` builds from this checkout. `latest` pulls the most recently published images
# (published on purpose, not on every release); a version tag freezes a specific build.
VPT_IMAGE_TAG=local
VPT_REGISTRY=ghcr.io/angelstreetcorp

# ---------------------------------------------------------------------------
# Platform identity and secrets
# ---------------------------------------------------------------------------
SERVER_NAME=vpt-docker
HOST_NAME=docker-host
API_KEY=CHANGE_ME
FLASK_SECRET_KEY=CHANGE_ME
MCP_SECRET_KEY=CHANGE_ME
AUTO_SIGN_ENABLED=false

# ---------------------------------------------------------------------------
# /server/* auth posture. Default = OPEN MODE: no login, every API call accepted.
# Only for a machine on a trusted network. To enforce login:
#   SERVER_OPEN_MODE=false
#   VITE_SUPABASE_URL=http://<PUBLIC_HOST>:54321
#   VITE_SUPABASE_ANON_KEY=<the ANON_KEY below>
#   ./launch.sh                # recreate: the frontend reads VITE_* at container start
# then create a user in Supabase Studio (http://<PUBLIC_HOST>:54321, Authentication).
# Behind an HTTPS tunnel, publish the Supabase gateway (:54321) on its own hostname and
# tell GoTrue and Studio about it, or login redirects point at http://<PUBLIC_HOST>:54321:
#   SUPABASE_PUBLIC_URL=https://auth.example.com     # also the value for VITE_SUPABASE_URL
#   SITE_URL=https://app.example.com                 # the frontend's public URL
# ---------------------------------------------------------------------------
SERVER_OPEN_MODE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Outbound mail for signup confirmation / password recovery. Without a relay every new
# account is confirmed on the spot. With one, set ENABLE_EMAIL_AUTOCONFIRM=false so a user
# must click the link mailed to them (the link points at SUPABASE_PUBLIC_URL).
#   SMTP_HOST=mail.example.com
#   SMTP_PORT=587
#   SMTP_USER=noreply@example.com
#   SMTP_PASS=
#   SMTP_ADMIN_EMAIL=noreply@example.com
#   SMTP_SENDER_NAME=VirtualPyTest
#   ENABLE_EMAIL_AUTOCONFIRM=false

# ---------------------------------------------------------------------------
# Supabase (self-hosted, vendored in setup/docker/supabase/)
# ANON_KEY / SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET — launch.sh derives them.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME
JWT_EXPIRY=3600
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE_ME
PG_META_CRYPTO_KEY=CHANGE_ME
SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322

# ---------------------------------------------------------------------------
# Storage — MinIO runs inside the stack (public-URL mode). To use Cloudflare R2
# instead, set CLOUDFLARE_R2_ENDPOINT / _ACCESS_KEY_ID / _SECRET_ACCESS_KEY /
# _BUCKET / _PUBLIC_URL here; they take precedence over MINIO_*.
# ---------------------------------------------------------------------------
MINIO_ACCESS_KEY=vpt
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=virtualpytest

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# AI features (optional — leave empty to run without them)
# ---------------------------------------------------------------------------
AI_AGENT_PROVIDER=
AI_AGENT_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Host-only mode (./launch.sh --host-only): this machine is a device controller
# for a server that runs elsewhere. Uncomment and fill; the stack values above
# are then unused.
# ---------------------------------------------------------------------------
# SERVER_URL=http://<server-address>:5109
# API_KEY=<the server's API_KEY>
# SUPABASE_URL=http://<server-address>:54321
# SUPABASE_ANON_KEY=<the server's ANON_KEY>
# SUPABASE_SERVICE_ROLE_KEY=<the server's SERVICE_ROLE_KEY>
# MINIO_ENDPOINT=http://<server-address>:9000
# MINIO_PUBLIC_URL=http://<server-address>:9000
